# Dependencies
node_modules/
**/node_modules/

# Next.js build output
app/.next/
app/out/

# Persistent data — lives on the Railway volume, never in the repo
app/data/
# NOTE: app/public/sites/<slug>/ (per-site static assets, ~16MB) IS committed
# so client websites render on deploy without re-running the importer.

# Seed/template SQLite DBs — these contained live secrets + PII and must never
# be committed. Ship seed data as code (a seed script), not as a binary DB.
app/seed/**/*.db
app/seed/**/*.db-shm
app/seed/**/*.db-wal

# Secrets / env
.env
.env.*
!.env.example

# Logs / OS
*.log
.DS_Store

# Local scratch
*.bak-*
