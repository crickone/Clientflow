XNlX2lkIjoxMDEzOSwiZHVyYXRpb25fcyI6MTM4LCJ1cmxnZW5fc291cmNlIjoid3d3In0\\u00253D&ccb=17-1&vs=33299ec87be5d991&_nc_vs=HBksFQIYRWZiX2VwaGVtZXJhbC83QTQwQkNCMUU2QjQwRjA1QzA3Q0ZBRDM0NEFEQzFBMl9tdF8xX3ZpZGVvX2Rhc2hpbml0Lm1wNBUAAsgBEgAVAhhAZmJfcGVybWFuZW50LzkyNEVFRTZCOUFCM0FGOUQ1M0QzREFENTc3MEM0QkJDX2F1ZGlvX2Rhc2hpbml0Lm1wNBUCAsgBEgAoABgAGwKIB3VzZV9vaWwBMRJwcm9ncmVzc2l2ZV9yZWNpcGUBMRUAACag3uPIi_66AxUCKAJDMywXQGFe6XjU_fQYGWRhc2hfaDI2NC1iYXNpYy1nZW4yXzcyMHARAHUAZbaeAQA&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&_nc_ss=7b2a8&_nc_zt=28&oh=00_Af5ervwPTZnog11CeVZcvPTG41vAtHbKRrlPI0ldmHLszw&oe=6A066E24\",\"video_preview_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/649856530_4185728458422976_3860350869371844170_n.jpg?_nc_cat=106&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=ak9r94MTJ-MQ7kNvwFxMVBF&_nc_oc=AdqbquaIndkE3useVq-tvukglHsOAwxkVK4FYRGAmWpy9gvlrL_Pldgb2Kl4ctmoUxJNOt96rhBNheDV5mJ0B_Aw&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&_nc_ss=7b2a8&oh=00_Af5Eaz120XhS52Fl1PnAcU7-Si3KOzK_Jy-S3lNb3g17UQ&oe=6A065761\",\"video_sd_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/o1/v/t2/f2/m412/AQPnWY4kCirhVe6YWm12wdA3CVnbTKVsFRdf20A6b-LJ1gHPydiWIJzLJ9Mn2rZp81_cEz4yw_dYavvloJFqYFeA7ENKpNXkZYesgtqWvA.mp4?_nc_cat=101&_nc_oc=AdpD60QvAHdND5f1IoD8VvjxXUt0NrDcsHSHsGPjvmuWRZJCB-3S3gxgcTndWdC5OCx1lYFVpWMpAHMeuz5dON-_&_nc_sid=8bf8fe&_nc_ht=scontent.fdub4-2.fna.fbcdn.net&_nc_ohc=W_QKH4nN7ooQ7kNvwGJtAZw&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5WSV9VU0VDQVNFX1BST0RVQ1RfVFlQRS4uQzMuMzYwLnN2ZV9zZCIsInhwdl9hc3NldF9pZCI6OTc0MTM0NDk1MTgwNjg4LCJhc3NldF9hZ2VfZGF5cyI6NjAsInZpX3VzZWNhc2VfaWQiOjEwMTM5LCJkdXJhdGlvbl9zIjoxMzgsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ\\u00253D\\u00253D&ccb=17-1&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&_nc_ss=7b2a8&_nc_zt=28&oh=00_Af4oTKoXYXJwpPGaZAcIICms7oep16djhbNXf0QofWHTPg&oe=6A0659D9\",\"watermarked_video_hd_url\":null,\"watermarked_video_sd_url\":null}],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"PrimePath Solutions\",\"impressions_with_index\":{\"impressions_text\":null,\"impressions_index\":-1},\"gated_type\":\"ELIGIBLE\",\"categories\":[\"UNKNOWN\"],\"is_aaa_eligible\":true,\"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778310000,\"publisher_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"AUDIENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1773126000,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"905863869088666\",\"collation_count\":1,\"collation_id\":\"938658338592356\",\"page_id\":\"894139760445478\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"894139760445478\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/61582489384780/\",\"root_reshared_post\":null,\"byline\":\"\",\"disclaimer_label\":null,\"page_name\":\"Amber Hayes\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/639451577_853692631057078_6518101323405634789_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=101&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=owCJTIkylJUQ7kNvwFIPmty&_nc_oc=Adr0B5ZZPGSbdY2RvsGc3RC-p1DtcxIlOUd26ShPE2ZrhbYb8uIXjCIhCuncT6QhYgLWnzmRtJLBcyk11j5v7-AL&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&_nc_ss=7b2a8&oh=00_Af5s-eSIVPPhsRhOAbzUoMIZ5KTqUyEZzlv02Q7uSb3otQ&oe=6A0657E8\",\"event\":null,\"caption\":\"groundingwell.com\",\"cta_text\":\"Shop now\",\"cards\":[],\"body\":{\"text\":\"Gabapentin is one of the most commonly prescribed medications for nerve pain. For a long time, it felt like the only real option when you're dealing with neuropathy that won't quit.\\n\\nIn fact, I was taking 3600mg every single day for almost three years. It became part of my routine, and honestly, I thought I'd be on it for the rest of my life.\\n\\nBut is gabapentin actually as effective as we think? And is it really side-effect free? A major clinical review published in the Cochrane Database says otherwise.\\n\\nThe researchers analyzed data from thousands of adults with chronic neuropathic pain and found something surprising: only about 3 to 4 out of every 10 people taking gabapentin experienced significant pain relief. That means the majority of people don't get the results they're hoping for.\\n\\nEven worse, the study showed that higher doses led to more side effects \\u2014 dizziness, fatigue, brain fog, and coordination problems. And if you try to stop taking it? Withdrawal symptoms can hit hard.\\n\\nYou can read the full study here: https://pubmed.ncbi.nlm.nih.gov/28597471/\\n\\nGabapentin was never designed to \\\"cure\\\" nerve pain in the first place. It's meant to calm overactive nerves by affecting how your brain processes pain signals.\\n\\nBut when you're taking it every day at high doses, you're basically masking the problem instead of helping your body actually heal. And that's why gabapentin can come with side effects like:\\n\\n- Constant brain fog and memory issues\\n- Extreme fatigue that makes you feel like a zombie\\n- Dizziness and balance problems\\n- Dependency and withdrawal if you try to stop\\n\\nAnd that raised an important question for me. Do I really want to depend on this every single day for the rest of my life, or is there a way to help my body feel better naturally?\\n\\nThat's when I decided to try getting off gabapentin. But I didn't just stop cold turkey \\u2014 I knew I needed to find alternatives first.\\n\\nSo I tried everything people recommend for neuropathy relief:\\n\\nI started with alpha-lipoic acid (ALA), then switched to R-ALA because everyone said it absorbed better. I tried acetyl-L-carnitine for nerve regeneration. I took B-complex vitamins and even got B12 shots for months thinking it would help.\\n\\nI tried magnesium glycinate before bed, turmeric curcumin for inflammation, and omega-3 fish oil because someone told me it could help with nerve health.\\n\\nI used capsaicin cream (with gloves, learned that the hard way), lidocaine patches, and every topical balm I could find. I bought a TENS unit, tried infrared heat therapy, and even wore compression socks at night.\\n\\nSome of it helped a little. The ALA maybe took a slight edge off. The TENS unit felt good temporarily. But nothing really stuck. I was still waking up with burning feet, still dealing with the constant buzzing and aching.\\n\\nAnd honestly, I felt like I was spending all my time and money chasing relief that never lasted more than a few hours.\\n\\nThen one night, after barely sleeping because my feet were on fire, I came across something I'd never considered before: grounding mats.\\n\\nAt first I thought... really? After everything I just tried, a mat is gonna help? But I kept reading testimonials from people with neuropathy who said it genuinely made a difference. Not as a cure, but as something that helped their nervous system calm down.\\n\\nI figured, what's the worst that could happen? So I ordered one. \\n\\nAfter using it for about a week, I started noticing something. The burning sensation in my feet wasn't as intense at night. The constant nerve pain felt more manageable during the day. I was sleeping better. And overall, my body just felt calmer, like it wasn't stuck in overdrive 24/7.\\n\\nI don't fully understand the science behind it \\u2014 something about reducing inflammation and helping your body discharge electrical stress. Honestly, I don't care about the technical details. All I know is that it's been helping me in a way nothing else has.\\n\\nWhat I love about the mat is how easy it is to use. You can put it under your feet while working, place it on the couch while watching TV, or keep it beside you during the day. You don't have to change your routine at all.\\n\\nThat was four months ago. I'm still using it every day. And here's the thing \\u2014 I've been completely off gabapentin for two months now. No more brain fog. No more zombie-like fatigue. No more withdrawal hell.\\n\\nI still have neuropathy. I'm not gonna sit here and say I'm cured. But the pain is genuinely more manageable now, and I'm doing it without pumping my body full of medication that was only working for 3 out of 10 people anyway.\\n\\nIt's not a miracle. But it's helped me more than gabapentin ever did, and I don't have to deal with the side effects anymore.\\n\\nThey're running some kind of discount right now (I think up to 67\\u0025 off?). If you're on gabapentin and wondering if there's another way, or if you're dealing with nerve pain and don't want to start medication in the first place... it might be worth trying.\\n\\nThe one I use is from GroundingWell: https://www.groundingwell.com/products/groundingwell-mat\\n\\nIf anyone else has gotten off gabapentin or found ways to manage neuropathy without it, I'd love to hear what worked for you.\"},\"cta_type\":\"SHOP_NOW\",\"display_format\":\"IMAGE\",\"link_description\":\"Greatest Health Rediscovery\",\"link_url\":\"https://www.groundingwell.com/products/groundingwell-mat\",\"images\":[{\"image_crops\":[],\"original_image_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/640384247_1215098754078911_3435840897411956784_n.jpg?_nc_cat=109&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=YSpddK2OXgsQ7kNvwH2BjOG&_nc_oc=Adp4qjAFudkrFd0P8iPQldeAWB7ilKslbhA0CZOK1E8gaA7dOj8eVoEenyZkgF_HJrJueBir97zfC631-ejCQVmA&_nc_zt=14&_nc_ht=scontent.fdub8-1.fna&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&_nc_ss=7b2a8&oh=00_Af5pxqZWhPUk5HKv1B7un7VJZZ9wMTHRBjHv5B4cqWmi6w&oe=6A067456\",\"resized_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/640928737_1619413366038433_7202011828400543261_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=104&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=ioIKv1oS0w4Q7kNvwHwVpn4&_nc_oc=AdqnlP6ywoiGlXIpg0cJbCl_DnUvMZ6pLGA70g1Rf3MRiYMNcFV5g2qXZ-RTit-c7w9SlxFXlLdomgE6Es2C0JbX&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&_nc_ss=7b2a8&oh=00_Af7yiXqQuotxAk_o8NLRDQdbQo5GJMj0vmot4qxGkyCs1g&oe=6A066862\",\"watermarked_resized_image_url\":\"\"}],\"page_categories\":[\"Digital Creator\"],\"page_like_count\":685,\"title\":\"All-Natural Nerve Pain Relief\",\"videos\":[],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"Amber Hayes\",\"impressions_with_index\":{\"impressions_text\":null,\"impressions_index\":-1},\"gated_type\":\"ELIGIBLE\",\"categories\":[\"UNKNOWN\"],\"is_aaa_eligible\":true,\"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778310000,\"publisher_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"AUDIENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1770278400,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"3917933181833296\",\"collation_count\":1,\"collation_id\":\"2049793619012796\