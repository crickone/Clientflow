            "size": 167973,
            "mimeType": "text/html",
            "text": "{\"data\":{\"ad_library_main\":{\"search_results_connection\":{\"edges\":[{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"1464601728651749\",\"collation_count\":1,\"collation_id\":\"2304110646746999\",\"page_id\":\"360373860492555\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"360373860492555\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/healray.official/\",\"root_reshared_post\":null,\"byline\":null,\"disclaimer_label\":null,\"page_name\":\"HealRay\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/667853707_1763692674610944_3754295013518336925_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=101&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=ogHnhN0HwXcQ7kNvwHn75OJ&_nc_oc=Ado5VM6NOUo12-WuSJsNoXXsQWofmxPg0X6F_zDfVD93vHBP5dbQBh-6LJ8SYb6U-OFOQz8Go5UFPzrgeYIL0zlK&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=6-kTPdJNsTzJsSbLLp8ccA&_nc_ss=7b2a8&oh=00_Af7Nnr7KLeH8KEISOYg9Y-lH6DUVg7vvzZDSeRbPDkWDNg&oe=6A067A9E\",\"event\":null,\"caption\":\"tryhealray.com\",\"cta_text\":\"Learn more\",\"cards\":[],\"body\":{\"text\":\"Receding gums aren\\u2019t just about brushing harder or flossing more.\\n\\nThey\\u2019re often linked to collagen breakdown and chronic inflammation.\\n\\nHealRay uses targeted red and infrared light to support gum tissue at the source - right from home.\\n\\n\\u2705 Supports healthier gum structure\\n\\u2705 Helps calm irritation and sensitivity\\n\\u2705 Takes just 5 minutes a day\\n\\nLearn what\\u2019s really happening inside receding gums \\u2192 https://tryhealray.com/pages/gum-health-collagen\"},\"cta_type\":\"LEARN_MORE\",\"display_format\":\"VIDEO\",\"link_description\":null,\"link_url\":\"https://tryhealray.com/pages/gum-health-collagen\",\"images\":[],\"page_categories\":[\"Cosmetic Dentist\"],\"page_like_count\":2610,\"title\":\"Try It Risk Free For 60 Days\",\"videos\":[{\"video_hd_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/o1/v/t2/f2/m366/AQM30UM59lpfKWf36QUxmZZI2_9R