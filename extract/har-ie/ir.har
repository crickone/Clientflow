          "content": {
            "size": 166923,
            "mimeType": "text/html",
            "text": "{\"data\":{\"ad_library_main\":{\"search_results_connection\":{\"edges\":[{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"960523363377492\",\"collation_count\":1,\"collation_id\":\"1275563318040047\",\"page_id\":\"100199106121016\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"100199106121016\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/100083668906509/\",\"root_reshared_post\":null,\"byline\":null,\"disclaimer_label\":null,\"page_name\":\"Laugh and Share\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/678506131_1725849645454983_4947794570958123673_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=104&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=wUv70-vXG6wQ7kNvwG62J_4&_nc_oc=AdpK8e6PtxyY-pfvqHGlyhVUcqY8rq12XZ1FmSmObWD2BB7v-IznGXJ-lZjVNNETPxiwauzVvthS40SxWVvU8aly&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=ruwhb5-fBE7aW_1pM4I7Tg&_nc_ss=7b2a8&oh=00_Af7efL9i4f3KaFToPqlt4OnVLqzO05JqFcQ6FR164kAQgA&oe=6A066FDD\",\"event\":null,\"caption\":\"secure.glowfreedoms.com\",\"cta_text\":\"Shop now\",\"cards\":[],\"body\":{\"text\":\"\\ud83d\\udd2c Your Morning Hand Stiffness Is Not An Arthritis Symptom. It Is A Circulation Symptom. \\ud83d\\udd2c\\n58 million Americans have been told the same thing: morning stiffness is a symptom of arthritis. It's expected. It's manageable. \\ud83d\\udcab\\nWhat almost none of them have been told: morning hand stiffness is not primarily a joint symptom. It's a circulation symptom. The joint isn't more damaged overnight \\u2014 it's more poorly supplied with blood. \\u2728\\nCompression gloves address fluid pressure around the joint. Far infrared addresses blood flow into it. Those are two completely different problems \\u2014 and for 70 years, the entire industry has only been treating one. \\ud83e\\ude7a\\nInfraFlex\\u2122 combines both mechanisms in one glove. Immediate compression relief. Continuous FIR circulation improvement. The effect continues after you take it off. \\ud83d\\udc9b\\n$39. 90-day guarantee. Treat the right problem \\ud83d\\udc49 https://secure.glowfreedoms.com/infraflex/139/adv/v2\"},\"cta_type\":\"SHOP_NOW\",\"display_format\":\"IMAGE\",\"link_description\":\"Morning hand stiffness is not primarily a joint symptom \\u2014 it's a circulation symptom. The joint isn't more damaged overnight. It's more poorly supplied with blood. That distinction changes everything about how you treat it\",\"link_url\":\"https://secure.glowfreedoms.com/infraflex/139/adv/v2\",\"images\":[{\"image_crops\":[],\"original_image_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/681827240_2047399679548491_2404694449883115779_n.jpg?_nc_cat=110&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=keHNsvVm1xQQ7kNvwFEVkqx&_nc_oc=Adqm9BJ1_ZqLjyg4IC_SlxngXUw8J1x3I-fW_qgdhVNGDYGPJFjDnred_gRRhyXI0EwlUaIkOVVc6q47d2ch_MRy&_nc_zt=14&_nc_ht=scontent.fdub8-1.fna&_nc_gid=ruwhb5-fBE7aW_1pM4I7Tg&_nc_ss=7b2a8&oh=00_Af4WCnRz5of5V4xmJV6FcnqhbtF27NfhP_iGdAeQ6gac8A&oe=6A067841\",\"resized_image_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/679849131_26327157013633896_5284223124000407933_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=109&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=GOsksvRyCAYQ7kNvwGCRyel&_nc_oc=Adq0sSY6KCLIQ4ETtabQMCsYIeyZbWt8gLEeWNCSs_GtOC8GaoC3PMDDA65hEZR-E2zuHiZp68Cvutx54FqyW0az&_nc_zt=14&_nc_ht=scontent.fdub8-1.fna&_nc_gid=ruwhb5-fBE7aW_1pM4I7Tg&_nc_ss=7b2a8&oh=00_Af4HdBp-pJyuCfr24EHqZhXLnK3OJR4EYQQcm3FdQ8UWoA&oe=6A067CC5\",\"watermarked_resized_image_url\":\"\"}],\"page_categories\":[\"Topic\"],\"page_like_count\":981,\"title\":\"Your Morning Hand Stiffness Is Not An Arthritis Symptom. It Is A Circulation Symptom.\",\"videos\":[],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is