root_reshared_post\":null,\"byline\":\"\",\"disclaimer_label\":null,\"page_name\":\"Testolite\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/612131487_2299647670531696_4270630206871860886_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=105&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=R0dCSHHu1D8Q7kNvwEmOOMS&_nc_oc=Ado2SJTAcUbT8DlDvXf3EjK8eYm6iO6QHIMrb3L2AdToj__1qoqLgKKFKsbOZXxlwGe4x4EVHO3K1Qh3mZ-7j9A_&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=xYj0uHfXfaEUd15JPmcclQ&_nc_ss=7b2a8&oh=00_Af4wydRU647VQwB91eRzSjc8lDpfxFgROkYXsZLrxd08Uw&oe=6A066930\",\"event\":null,\"caption\":\"offer.testolite.com\",\"cta_text\":\"Learn more\",\"cards\":[],\"body\":{\"text\":\"Is Testolite a scam?\\n\\nWe see this question come up, and honestly\\u2014we\\u2019d be asking the same thing.\\n\\nThe testosterone space is a dumpster fire. Pills that do nothing. Injections that shrink your boys and leave you dependent for life. Marketing that promises you\\u2019ll turn into a Greek god if you just buy their magic powder.\\n\\nSo yeah, when you hear about a red light device for your balls, the scam alarm goes off. We get it.\\n\\nBut here\\u2019s what we can tell you:\\n\\n10,000+ guys are using Testolite devices right now. We\\u2019ve sold out three times this year\\u2014and it\\u2019s not because we\\u2019re running Super Bowl ads.\\n\\n It\\u2019s because men are actually seeing changes.\\n\\nEnergy\\u2019s back.\\n\\nThe gym feels productive again. The bedroom\\u2019s working like it should.\\n\\nThat soft midsection? Melting off.\\n\\nSome guys are even seeing their hair grow back as T levels climb.\\n\\nBut here\\u2019s what really matters\\u2014confidence is coming back.\\n\\nMen are feeling like themselves again, instead of some watered-down version.\\n\\nDon\\u2019t just take our word for it. Check the reviews on our website or on third-party sites like Trustpilot.\\n\\nReal guys. Real talk. Real results.\\n\\nThe science is solid. Over 2,000 clinical trials and 40+ years of research on red light therapy.\\n\\nStill not 100\\u0025 convinced?\\n\\nWe offer a 60-day money-back guarantee. \\n\\nTry it\\u2014if you don\\u2019t feel anything, get a full refund. No questions asked.\\n\\nClick the link below and get your device at a 50\\u0025 off today.\"},\"cta_type\":\"LEARN_MORE\",\"display_format\":\"IMAGE\",\"link_description\":\"Science-Backed Testosterone Optimization at Home\",\"link_url\":\"https://offer.testolite.com/bl-pdp-dual/\",\"images\":[{\"image_crops\":[],\"original_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/612378771_1517076496038576_7747800738157469551_n.jpg?_nc_cat=103&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=BTufMmbUjkMQ7kNvwGnOOzt&_nc_oc=AdpBVQ4_Lcog_dTBbE52B5z1B4oW7Bc3SgAH9NaF72NlNOb0BXzE8oeckBGoT-AUkTQBMfHlTZsOUm6CyvauE1v7&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=xYj0uHfXfaEUd15JPmcclQ&_nc_ss=7b2a8&oh=00_Af6OE97bstuC-yFOEV2bADstK4Z4ii2gMDahulFdHKshrA&oe=6A068526\",\"resized_image_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/613415391_1360733618708552_6166101062085513601_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=111&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=aFKwxxMgzNwQ7kNvwHJ09sV&_nc_oc=Adrc48SYSrT6tcgw4Bb4dZtaQYZ0dYMyz3dYS7Nd9oyiSbq7Xhr_EpaZaA8BK31kdWLrJ2enmxtYhmO-wDeC29l2&_nc_zt=14&_nc_ht=scontent.fdub8-1.fna&_nc_gid=xYj0uHfXfaEUd15JPmcclQ&_nc_ss=7b2a8&oh=00_Af78AeMnjDpXqqtFqSYy_KhIysZNrUvRYLDvKlZmRos7Ew&oe=6A067116\",\"watermarked_resized_image_url\":\"\"}],\"page_categories\":[\"Health/beauty\",\"Health & wellness website\"],\"page_like_count\":12328,\"title\":\"Try Testolite Today Risk Free\",\"videos\":[],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"Testolite\",\"impressions_wit