ENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1778050800,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"2301541900337076\",\"collation_count\":1,\"collation_id\":\"2754890804846930\",\"page_id\":\"688806050988249\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"688806050988249\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/61578604198236/\",\"root_reshared_post\":null,\"byline\":\"\",\"disclaimer_label\":null,\"page_name\":\"Isabelle Durand\",\"page_profile_picture_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/669212251_842381558888664_6334395805643332331_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=111&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=cyxNTisU_xkQ7kNvwEk0AwH&_nc_oc=AdoBnrY3XrDNZqACtbkQjQjf9UAztIVl4SCEEgPBKIxJGCni02tSmEd4XBYTENYrH0IYHMYMFuCvNKkzM0NroMTo&_nc_zt=14&_nc_ht=scontent.fdub8-1.fna&_nc_gid=ruwhb5-fBE7aW_1pM4I7Tg&_nc_ss=7b2a8&oh=00_Af6Q7dzU3tYBBejxElP2xKkXIf-XUQuuo4yz8lZAxRzE2g&oe=6A068339\",\"event\":null,\"caption\":\"getbarksy.co\",\"cta_text\":\"Shop now\",\"cards\":[],\"body\":{\"text\":\"She stopped jumping on the bed \\ud83d\\udecc.\\n\\nYou told yourself she just found a new spot. That maybe she preferred the floor now. That it was fine.\\nBut you knew.\\n\\nDogs don't complain. They adapt. They go quiet. They skip the stairs, stop asking for the walk, and look up at you with those eyes that say I'm okay \\u2014 even when they're not.\\n\\nBy the time you see the limp, the inflammation has already been building for months.\\n\\nRedPaw is the vest that works while she rests. 222 clinical-grade LED chips. Two healing wavelengths. Zero needles, zero drugs, zero EMF. Just 30 minutes a day \\u2014 and the kind of care she'd ask for if she could.\\n\\n\\\"Six weeks later, no surgery.\\\" \\u2014 Taylor R., French Bulldog parent\\n\\ud83d\\udc3e 4.9 stars \\u00b7 2,347 reviews \\u00b7 Vet recommended\"},\"cta_type\":\"SHOP_NOW\",\"display_format\":\"IMAGE\",\"link_description\":\"12,000+ Dogs healed \\ud83d\\udc36\",\"link_url\":\"https://getbarksy.co/products/redpaw\",\"images\":[{\"image_crops\":[],\"original_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/669064423_26464966439861925_7812423970888060384_n.jpg?_nc_cat=101&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=4TROB_JHTxYQ7kNvwHm7x-J&_nc_oc=Adr0c2C0gC-mJfi6L11Qx1gQ5aN1hkmHmbtBgJQcqPPlq1AdTz7w2AW339Hg7N6y2uLayFhn5FsJ3FMZiE18yS-C&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=ruwhb5-fBE7aW_1pM4I7Tg&_nc_ss=7b2a8&oh=00_Af5sVysRQkVZNllvoYOoX70yXt0-CSYoAAUI49KgjnwDxA&oe=6A067344\",\"resized_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/663335964_1136676125261505_9184761096043236566_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=107&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=EKqXsOYhjF4Q7kNvwEdBQHx&_nc_oc=AdrCmmJ1BLrnA3EjYwrPd4l1uma-YKT__K3pPx4WtLcPXbDRpvmeppHmqiHUURi1bpM5IycWO0MvcTr2sz3_vlkg&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=ruwhb5-fBE7aW_1pM4I7Tg&_nc_ss=7b2a8&oh=00_Af4Uc9pu-HcjZCjgnc7wjtSOjcKvnGk9aRistffakdt3aQ&oe=6A065D3C\",\"watermarked_resized_image_url\":\"\"}],\"page_categories\":[\"Health/beauty\"],\"page_like_count\":78,\"title\":\"40\\u0025 Off Until Out of Stock\\ud83d\\ude0d\",\"videos\":[],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"Isabelle Durand\",\"impressions_with_index\":{\"impressions_text\":null,