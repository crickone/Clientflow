nc_zt=28&oh=00_Af4UT_yCYEnadmU7mYwm9HxtZRE2zcflHqngpf6AiqfMSQ&oe=6A066633\",\"watermarked_video_hd_url\":null,\"watermarked_video_sd_url\":null}],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"The One Device\",\"impressions_with_index\":{\"impressions_text\":null,\"impressions_index\":-1},\"gated_type\":\"ELIGIBLE\",\"categories\":[\"UNKNOWN\"],\"is_aaa_eligible\":true,\"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778396400,\"publisher_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"AUDIENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1773298800,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"26029607119984827\",\"collation_count\":1,\"collation_id\":\"874436415379236\",\"page_id\":\"894139760445478\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"894139760445478\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/61582489384780/\",\"root_reshared_post\":null,\"byline\":\"\",\"disclaimer_label\":null,\"page_name\":\"Amber Hayes\",\"page_profile_picture_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/638631923_2018369808706755_143872713382270022_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=108&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=10ov8aXokSgQ7kNvwEF8DIz&_nc_oc=Adpg8i-jEt1Uraj_m0UIwHN_P_VonhHcN2kIw-v9zuNf1ARoRjNP9rR6J1bgJbGnjEwg6go36PlfUYLW8RO1UWie&_nc_zt=14&_nc_ht=scontent.fdub8-1.fna&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&_nc_ss=7b2a8&oh=00_Af5TX6JbDEma_8qKepF7vs2yCEQ63D1DgJDVI1On0xzPbA&oe=6A0678EA\",\"event\":null,\"caption\":\"groundingwell.com\",\"cta_text\":\"Shop now\",\"cards\":[],\"body\":{\"text\":\"Gabapentin is one of the most commonly prescribed medications for nerve pain. For a long time, it felt like the only real option when you're dealing with neuropathy that won't quit.\\n\\nIn fact, I was taking 3600mg every single day for almost three years. It became part of my routine, and honestly, I thought I'd be on it for the rest of my life.\\n\\nBut is gabapentin actually as effective as we think? And is it really side-effect free? A major clinical review published in the Cochrane Database says otherwise.\\n\\nThe researchers analyzed data from thousands of adults with chronic neuropathic pain and found something surprising: only about 3 to 4 out of every 10 people taking gabapentin experienced significant pain relief. That means the majority of people don't get the results they're hoping for.\\n\\nEven worse, the study showed that higher doses led to more side effects \\u2014 dizziness, fatigue, brain fog, and coordination problems. And if you try to stop taking it? Withdrawal symptoms can hit hard.\\n\\nYou can read the full study here: https://pubmed.ncbi.nlm.nih.gov/28597471/\\n\\nGabapentin was never designed to \\\"cure\\\" nerve pain in the first place. It's meant to calm overactive nerves by affecting how your brain processes pain signals.\\n\\nBut when you're taking it every day at high doses, you're basically masking the problem instead of helping your body actually heal. And that's why gabapentin can come with side effects like:\\n\\n- Constant brain fog and memory issues\\n- Extreme fatigue that makes you feel like a zombie\\n- Dizziness and balance problems\\n- Dependency and withdrawal if you try to stop\\n\\nAnd that raised an important question for me. Do I really want to depend on this every single day for the rest of my life, or is there a way to help my body feel better naturally?\\n\\nThat's when I decided to try getting off gabapentin. But I didn't just stop cold turkey \\u2014 I knew I needed to find alternatives first.\\n\\nSo I tried everything people recommend for neuropathy relief:\\n\\nI started with alpha-lipoic acid (ALA), then switched to R-ALA because everyone said it absorbed better. I tried acetyl-L-carnitine for nerve regeneration. I took B-complex vitamins and even got B12 shots for months thinking it would help.\\n\\nI tried magnesium glycinate before bed, turmeric curcumin for inflammation, and omega-3 fish oil because someone told me it could help with nerve health.\\n\\nI used capsaicin cream (with gloves, learned that the hard way), lidocaine patches, and every topical balm I could find. I bought a TENS unit, tried infrared heat therapy, and even wore compression socks at night.\\n\\nSome of it helped a little. The ALA maybe took a slight edge off. The TENS unit felt good temporarily. But nothing really stuck. I was still waking up with burning feet, still dealing with the constant buzzing and aching.\\n\\nAnd honestly, I felt like I was spending all my time and money chasing relief that never lasted more than a few hours.\\n\\nThen one night, after barely sleeping because my feet were on fire, I came across something I'd never considered before: grounding mats.\\n\\nAt first I thought... really? After everything I just tried, a mat is gonna help? But I kept reading testimonials from people with neuropathy who said it genuinely made a difference. Not as a cure, but as something that helped their nervous system calm down.\\n\\nI figured, what's the worst that could happen? So I ordered one. \\n\\nAfter using it for about a week, I started noticing something. The burning sensation in my feet wasn't as intense at night. The constant nerve pain felt more manageable during the day. I was sleeping better. And overall, my body just felt calmer, like it wasn't stuck in overdrive 24/7.\\n\\nI don't fully understand the science behind it \\u2014 something about reducing inflammation and helping your body discharge electrical stress. Honestly, I don't care about the technical details. All I know is that it's been helping me in a way nothing else has.\\n\\nWhat I love about the mat is how easy it is to use. You can put it under your feet while working, place it on the couch while watching TV, or keep it beside you during the day. You don't have to change your routine at all.\\n\\nThat was four months ago. I'm still using it every day. And here's the thing \\u2014 I've been completely off gabapentin for two months now. No more brain fog. No more zombie-like fatigue. No more withdrawal hell.\\n\\nI still have neuropathy. I'm not gonna sit here and say I'm cured. But the pain is genuinely more manageable now, and I'm doing it without pumping my body full of medication that was only working for 3 out of 10 people anyway.\\n\\nIt's not a miracle. But it's helped me more than gabapentin ever did, and I don't have to deal with the side effects anymore.\\n\\nThey're running some kind of discount right now (I think up to 67\\u0025 off?). If you're on gabapentin and wondering if there's another way, or if you're dealing with nerve pain and don't want to start medication in the first place... it might be worth trying.\\n\\nThe one I use is from GroundingWell: https://www.groundingwell.com/products/groundingwell-mat\\n\\nIf anyone else has gotten off gabapentin or found ways to manage neuropathy without it, I'd love to hear what worked for you.\"},\"cta_type\":\"SHOP_NOW\",\"display_format\":\"IMAGE\",\"link_description\":\"Greatest Health Rediscovery\",\"link_url\":\"https://www.groundingwell.com/products/groundingwell-mat\",\"images\":[{\"image_crops\":[],\"original_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/641319867_1322380439712752_4990033731059965518_n.jpg?_nc_cat=105&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=Uy87Z_o-e30Q7kNvwF5PQm_&_nc_oc=AdrX8AP8lvsd3FDVqTnzjaCygyw2QaUVlQ-B1tJgzdVo4cifVerEgYQbgNpucDz8sZS9UjtDg-GLoed50lnldwhN&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&_nc_ss=7b2a8&oh=00_Af4nWMN5FF0Nq_EBIs_imP2tuINe1HIvwRBMKwSwtM4n_w&oe=6A065595\",\"resized_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/637791321_1549810912797345_8693554002748557509_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=104&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=ecRMwJs5EdYQ7kNvwH6nN2l&_nc_oc=AdqRoHReyE6x_tdN1cpU5qJqlIE4TBr0rODKLFAD3Oj3jqm1TReb3VGbjHnJNURZ8wqK_8djwAGZAZELUCJgQuxt&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&_nc_ss=7b2a8&oh=00_Af5Ajjg9sDhIPGNQdKpxcRqtpXHgOzcgpGGSnWTmboBc_w&oe=6A06601D\",\"watermarked_resized_image_url\":\"\"}],\"page_categories\":[\"Digital Creator\"],\"page_like_count\":685,\"title\":\"All-Natural Nerve Pain Relief\",\"videos\":[],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"Amber Hayes\",\"impressions_with_index\":{\"impressions_text\":null,\"impressions_index\":-1},\"gated_type\":\"ELIGIBLE\",\"categories\":[\"UNKNOWN\"],\"is_aaa_eligible\":true,\"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778223600,\"publisher_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"AUDIENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1770278400,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"1598095907872827\",\"collation_count\":1,\"collation_id\":\"1408222797672404\",\"page_id\":\"894139760445478\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"894139760445478\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/61582489384780/\",\"root_reshared_post\":null,\"byline\":\"\",\"disclaimer_label\":null,\"page_name\":\"Amber Hayes\",\"page_profile_picture_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/629017806_1909871522969924_6839954701612671971_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=110&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=-srJut-K9V0Q7kNvwF9DxEc&_nc_oc=AdoHRBKbGF6PwbPRLFyh3bFwzDp-c4EYPd1FWWMjGY8RdacU-HE2X6pHVFZupvWq8v_4Nlms2pkn3OldoKRa2I6f&_nc_zt=14&_nc_ht=scontent.fdub8-1.fna&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&_nc_ss=7b2a8&oh=00_Af4TZSkRsbnUveWrJWmPuDI-KR6HNE83wLGtVWPJn7-CqQ&oe=6A067AD2\",\"event\":null,\"caption\":\"article.groundingwell.com\",\"cta_text\":\"Shop now\",\"cards\":[],\"body\":{\"text\":\"Gabapentin is one of the most commonly prescribed medications for nerve pain. For a long time, it felt like the only real option when you're dealing with neuropathy that won't quit.\\n\\nIn fact, I was taking 3600mg every single day for almost three years. It became part of my routine, and honestly, I thought I'd be on it for the rest of my life.\\n\\nBut is gabapentin actually as effective as we think? And is it really side-effect free? A major clinical review published in the Cochrane Database says otherwise.\\n\\nThe researchers analyzed data from thousands of adults with chronic neuropathic pain and found something surprising: only about 3 to 4 out of every 10 people taking gabapentin experienced significant pain relief. That means the majority of people don't get the results they're hoping for.\\n\\nEven worse, the study showed that higher doses led to more side effects \\u2014 dizziness, fatigue, brain fog, and coordination problems. And if you try to stop taking it? Withdrawal symptoms can hit hard.\\n\\nYou can read the full study here: https://pubmed.ncbi.nlm.nih.gov/28597471/\\n\\nGabapentin was never designed to \\\"cure\\\" nerve pain in the first place. It's meant to calm overactive nerves by affecting how your brain processes pain signals.\\n\\nBut when you're taking it every day at high doses, you're basically masking the problem instead of helping your body actually heal. And that's why gabapentin can come with side effects like:\\n\\n- Constant brain fog and memory issues\\n- Extreme fatigue that makes you feel like a zombie\\n- Dizziness and balance problems\\n- Dependency and withdrawal if you try to stop\\n\\nAnd that raised an important question for me. Do I really want to depend on this every single day for the rest of my life, or is there a way to help my body feel better naturally?\\n\\nThat's when I decided to try getting off gabapentin. But I didn't just stop cold turkey \\u2014 I knew I needed to find alternatives first.\\n\\nSo I tried everything people recommend for neuropathy relief:\\n\\nI started with alpha-lipoic acid (ALA), then switched to R-ALA because everyone said it absorbed better. I tried acetyl-L-carnitine for nerve regeneration. I took B-complex vitamins and even got B12 shots for months thinking it would help.\\n\\nI tried magnesium glycinate before bed, turmeric curcumin for inflammation, and omega-3 fish oil because someone told me it could help with nerve health.\\n\\nI used capsaicin cream (with gloves, learned that the hard way), lidocaine patches, and every topical balm I could find. I bought a TENS unit, tried infrared heat therapy, and even wore compression socks at night.\\n\\nSome of it helped a little. The ALA maybe took a slight edge off. The TENS unit felt good temporarily. But nothing really stuck. I was still waking up with burning feet, still dealing with the constant buzzing and aching.\\n\\nAnd honestly, I felt like I was spending all my time and money chasing relief that never lasted more than a few hours.\\n\\nThen one night, after barely sleeping because my feet were on fire, I came across something I'd never considered before: grounding mats.\\n\\nAt first I thought... really? After everything I just tried, a mat is gonna help? But I kept reading testimonials from people with neuropathy who said it genuinely made a difference. Not as a cure, but as something that helped their nervous system calm down.\\n\\nI figured, what's the worst that could happen? So I ordered one. \\n\\nAfter using it for about a week, I started noticing something. The burning sensation in my feet wasn't as intense at night. The constant nerve pain felt more manageable during the day. I was sleeping better. And overall, my body just felt calmer, like it wasn't stuck in overdrive 24/7.\\n\\nI don't fully understand the science behind it \\u2014 something about reducing inflammation and helping your body discharge electrical stress. Honestly, I don't care about the technical details. All I know is that it's been helping me in a way nothing else has.\\n\\nWhat I love about the mat is how easy it is to use. You can put it under your feet while working, place it on the couch while watching TV, or keep it beside you during the day. You don't have to change your routine at all.\\n\\nThat was four months ago. I'm still using it every day. And here's the thing \\u2014 I've been completely off gabapentin for two months now. No more brain fog. No more zombie-like fatigue. No more withdrawal hell.\\n\\nI still have neuropathy. I'm not gonna sit here and say I'm cured. But the pain is genuinely more manageable now, and I'm doing it without pumping my body full of medication that was only working for 3 out of 10 people anyway.\\n\\nIt's not a miracle. But it's helped me more than gabapentin ever did, and I don't have to deal with the side effects anymore.\\n\\nThey're running some kind of discount right now (I think up to 67\\u0025 off?). If you're on gabapentin and wondering if there's another way, or if you're dealing with nerve pain and don't want to start medication in the first place... it might be worth trying.\\n\\nThe one I use is from GroundingWell: https://article.groundingwell.com/f02\\n\\nIf anyone else has gotten off gabapentin or found ways to manage neuropathy without it, I'd love to hear what worked for you.\"},\"cta_type\":\"SHOP_NOW\",\"display_format\":\"IMAGE\",\"link_description\":\"Greatest Health Rediscovery\",\"link_url\":\"https://article.groundingwell.com/f02\",\"images\":[{\"image_crops\":[],\"original_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/639145035_775263255169604_3844618013653061749_n.jpg?_nc_cat=101&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=VGpXP92vyRgQ7kNvwEBLfzP&_nc_oc=AdqBy8B053iMm6UQ05Ma2N-fgfa0oIfrDseHlNmIHWLrm2t2r-9sxxyhtZ52CRJNEJ9ZwMOFMVwsuXvvnhalo7e4&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&_nc_ss=7b2a8&oh=00_Af5uwi_Q0nOKL90Q2dFsKVvFA4vyWoEavPldNr-qXydE-w&oe=6A067EE4\",\"resized_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/638669518_1853605478683423_2997179028568496724_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=103&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=d1_I6x2V9vYQ7kNvwHP6tyk&_nc_oc=AdoMhWtP11tRc_D2l5RKct3RKJiU27K6ldueYnX7oSRsSf3lQinccqGQktj743DZDzn1XhsJzvhZA0g1KYi1oqoZ&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&_nc_ss=7b2a8&oh=00_Af7obYjDpATgkxUJqrXW7HaeD48Ij2t7MVepEaA2Vbp3dg&oe=6A066EED\",\"watermarked_resized_image_url\":\"\"}],\"page_categories\":[\"Digital Creator\"],\"page_like_count\":685,\"title\":\"All-Natural Nerve Pain Relief\",\"videos\":[],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"Amber Hayes\",\"impressions_with_index\":{\"impressions_text\":null,\"impressions_index\":-1},\"gated_type\":\"ELIGIBLE\",\"categories\":[\"UNKNOWN\"],\"is_aaa_eligible\":true,\"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1777964400,\"publisher_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"AUDIENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1770278400,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"1411161314114784\",\"collation_count\":1,\"collation_id\":\"1022906590065864\",\"page_id\":\"1597953390472021\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"1597953390472021\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/100069921953169/\",\"root_reshared_post\":null,\"byline\":null,\"disclaimer_label\":null,\"page_name\":\"The Tanning Rooms\",\"page_profile_picture_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/690760936_1280851050695840_2537443956219969499_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=109&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=nLDryvJg5KEQ7kNvwFtfs_Z&_nc_oc=AdqNfcsDDh8JqEn3C8oYb7hP4w4lfNU0SdKfnMsCnBEUbgzBsihJ3UX3OPoeEGvDX6Pq1yciDRMOgCXrbDMCHyPl&_nc_zt=14&_nc_ht=scontent.fdub8-1.fna&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&_nc_ss=7b2a8&oh=00_Af4beUMK1oKm5l4G1G10ats7Lio5NHKW3UoQhXvNW905zw&oe=6A0678F3\",\"event\":null,\"caption\":null,\"cta_text\":\"No button\",\"cards\":[],\"body\":{\"text\":\"\\ud83d\\udea8 OPENING OFFER \\u2013 RED LIGHT THERAPY AT HOME \\ud83d\\udea8\\n\\nWhy pay per session\\u2026 when you can have it in your own home, every day?\\n\\n\\u2728 ONLY \\u00a3200 for 4 WEEKS\\nThat\\u2019s just \\u00a350 per week \\u2013 cheaper than most places charge for a single session\\n\\n\\u2714\\ufe0f Use it daily for real results\\n\\u2714\\ufe0f The whole household can use it\\n\\u2714\\ufe0f No appointments, no travel, no limits\\n\\u2714\\ufe0f Professional system \\u2013 same results, more convenience\\n\\n\\ud83d\\udca1You need consistent use to see results\\u2026\\nThis way, you actually get them \\ud83d\\udc4f\\n\\n\\u2728 633nm Red Light\\n\\u2728 850nm Near Infrared\\n\\u2728 5,000+ LED Performance System\\n\\nThis is NOT a sunbed \\u2013 this is results-driven skin & recovery therapy\\n\\n\\ud83d\\udcf2 LIMITED AVAILABILITY \\u2013 we expect these to go FAST\\nMessage now to secure yours\\n\\n\\ud83d\\udcde 02871361100\"},\"cta_type\":\"NO_BUTTON\",\"display_format\":\"IMAGE\",\"link_description\":null,\"link_url\":null,\"images\":[{\"image_crops\":[],\"original_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/687994564_1674395470242051_5462052643712768462_n.jpg?_nc_cat=101&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=msjhSdtYsQUQ7kNvwGnSGqf&_nc_oc=AdqTBrE2n9oi0ztiurMuBKt35kZxTXdhWlrDRaKU-doTiFPl3lpb30UaRtWlfwlCwcOyYKc643bGGz3rjSIEgXDH&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&_nc_ss=7b2a8&oh=00_Af5hKB5VMIhqoml3H2drRSq162nECoLuEhdgPDKmFS5n1A&oe=6A068CD4\",\"resized_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/690571152_1328889532433851_7156131256655626821_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=101&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=xzjnIryCt8MQ7kNvwEos62e&_nc_oc=Adpd_AA7qF9zTs8bg12GOZvfloBDt8WerKxWyGN5Jj8G62MHbBa6DU3lEXfqgNeoXfS1FiZTp91Uv0KmvgGLua_N&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&_nc_ss=7b2a8&oh=00_Af5TgpC35ikJ8I0sU0tD5oOmtSHUgQ4zdxHkZ8yxXc4N7A&oe=6A0675B5\",\"watermarked_resized_image_url\":\"\"}],\"page_categories\":[\"Beauty Salon\"],\"page_like_count\":13828,\"title\":null,\"videos\":[],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"The Tanning Rooms\",\"impressions_with_index\":{\"impressions_text\":null,\"impressions_index\":-1},\"gated_type\":\"ELIGIBLE\",\"categories\":[\"UNKNOWN\"],\"is_aaa_eligible\":true,\"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778396400,\"publisher_platform\":[\"FACEBOOK\"],\"start_date\":1778050800,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"1288824533133788\",\"collation_count\":1,\"collation_id\":\"1296080842426716\",\"page_id\":\"484651878062688\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"484651878062688\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/61568498576677/\",\"root_reshared_post\":null,\"byline\":null,\"disclaimer_label\":null,\"page_name\":\"PrimePath Solutions\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/649949593_783370824824458_991664713176886484_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=106&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=uh7RJQ8pb80Q7kNvwHOTOUk&_nc_oc=AdpFshg8l4i3Ll3IAAbx0APLg4IvR-G6XbGEfcz-LztUUsBfrnDWyrdSTt8YAT3JNolFGS1DhpGSUkP3l-l1zs6q&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=Q3qGSc4ezHPvjDfOi-POKg&