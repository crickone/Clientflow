ps://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/670869719_1231950755394669_6418415597854176247_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=107&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=QDcoqXYH7eYQ7kNvwEjtgfI&_nc_oc=Adow107sLD4r5LQ8XT2YJdK07LN69fLpIWXZSpo4z7F2Xg8Qo5HXx6VcJsNgGA7wKqPKwP-3g2SHDzuCDCmiCFmW&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=WMJpnBc_Ba85Rm55aQroMQ&_nc_ss=7b2a8&oh=00_Af644jfaYaTLNZF6YKw_MH8hMTC7M7GE2G2leATDiJvIgQ&oe=6A068322\",\"event\":null,\"caption\":\"fb.com\",\"cta_text\":\"Learn more\",\"cards\":[],\"body\":{\"text\":\"Receding gums aren\\u2019t just about brushing harder or flossing more.\\n\\nThey\\u2019re often linked to collagen breakdown and chronic inflammation.\\n\\nHealRay uses targeted red and infrared light to support gum tissue at the source - right from home.\\n\\n\\u2705 Supports healthier gum structure\\n\\u2705 Helps calm irritation and sensitivity\\n\\u2705 Takes just 5 minutes a day\\n\\nLearn what\\u2019s really happening inside receding gums \\u2192 https://www.myhealray.com/dental-news-advertorial\"},\"cta_type\":\"LEARN_MORE\",\"display_format\":\"VIDEO\",\"link_description\":null,\"link_url\":\"https://fb.com/canvas_doc/1732917621003414\",\"images\":[],\"page_categories\":[\"Cosmetic Dentist\"],\"page_like_count\":2610,\"title\":\"Try It Risk Free For 60 Days\",\"videos\":[{\"video_hd_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/o1/v/t2/f2/m366/AQNlaq0SsHnxP1nDU9yjWfn1InbwALA8ukfV3uULOhTWWj196EAf-p_iWZMeDKHltH9X4432jJK9Y3RrQ6lu9JVzdw5JApuWv9YDlBUUmw8qag.mp4?_nc_cat=110&_nc_oc=AdrmH0FF5hSc4S5D8o_ilGkg1JRgacCTXR886axMX_QtA7x9JlSu7DpP2sf7iV6W5adL8Snb-9dHvQ6mbYU6yGVL&_nc_sid=5e9851&_nc_ht=scontent.fdub8-1.fna.fbcdn.net&_nc_ohc=Hq7FshM2BLgQ7kNvwESz3me&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5WSV9VU0VDQVNFX1BST0RVQ1RfVFlQRS4uQzMuNzIwLmRhc2hfaDI2NC1iYXNpYy1nZW4yXzcyMHAiLCJ4cHZfYXNzZXRfaWQiOjQ0OTExMDgyMDQ1MDE1NDksImFzc2V0X2FnZV9kYXlzIjoyMywidmlfdXNlY2FzZV9pZCI6MTA3OTksImR1cmF0aW9uX3MiOjczLCJ1cmxnZW5fc291cmNlIjoid3d3In0\\u00253D&ccb