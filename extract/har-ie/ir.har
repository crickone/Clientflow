fo\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"Dr. James Harlow\",\"impressions_with_index\":{\"impressions_text\":null,\"impressions_index\":-1},\"gated_type\":\"ELIGIBLE\",\"categories\":[\"UNKNOWN\"],\"is_aaa_eligible\":true,\"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778396400,\"publisher_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"AUDIENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1777791600,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"1176688217823167\",\"collation_count\":1,\"collation_id\":\"950961657640282\",\"page_id\":\"343534518849003\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"343534518849003\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/61562061955567/\",\"root_reshared_post\":null,\"byline\":\"\",\"disclaimer_label\":null,\"page_name\":\"Irries\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/673138212_962620369481898_2029497478429430344_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=101&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=sk4P8Uiym-0Q7kNvwEj_ilZ&_nc_oc=AdoIoCWwfwDMXgNs5KHTFllkCLTKupt4n0drR7MgvVPYxITZ1GLhJk5d2Bpz0iTsd0vKgakLd5rTTJNnchPzB9pd&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=DYn9GJzeujERi96M2I5Tlw&_nc_ss=7b2a8&oh=00_Af5-gC--0vT5hXl0AJCh7eDrf-fBXX_46EbAOiff7TjDuA&oe=6A066C2E\",\"event\":null,\"caption\":\"irries.com\",\"cta_text\":\"Learn more\",\"cards\":[],\"body\":{\"text\":\"\\ud83d\\udea8 MUST SEE: why people on the verge of sciatica surgery are raving about this breakthrough device...\\n\\nYou've tried everything. PT. Injections. All the stretches/exercises in the world. And after nothing working, you think surgery is the only real fix.\\n\\nBut before you go under the knife \\u2014 you need to see this.\\n\\nThere\\u2019s something your surgeon probably hasn\\u2019t told you\\u2026\\n\\nYour sciatica can fix itself, naturally \\u2013 without going under the knife.\\n\\nAnd it's all thanks to a new medical breakthrough called \\u201cspontaneous disc resorption\\u201d\\n\\nTo keep it short, studies show your herniated disc can heal on its own and retract away from the nerve naturally.\\n\\nThe reason it hasn\\u2019t?\\n\\nIt's too busy suffering.\\n\\nIt needs the right environment to activate that process.\\n\\nIntroducing the Irries \\u201cUni Fusion\\u201d Belt \\u2014 the first device that activates your disc\\u2019s natural healing ability in just 20 minutes a day combining 4 clinically-backed therapies.\\n\\n\\ud83d\\udc49 Mechanical Decompression\\n\\ud83d\\udc49 Soothing Heat\\n\\ud83d\\udc49 BiWave Light Therapy (Near-Infrared + Red Light)\\n\\ud83d\\udc49 Deep Tissue Massage\\n\\nAll four running at the same time.\\n\\nIn one session at home.\\n\\nNo appointments. No recovery time. No surgery.\\nUsers are reporting significant relief in as little as 2\\u20133 weeks of daily use.\\n\\nTry the Irries \\u201cUni Fusion\\u201d Belt completely risk-free today:\\n\\n\\u2705 Addresses the real reason everything failed\\n\\u2705 Saves you from surgery\\n\\u2705 4 therapies in 1 device\\n\\u2705 Use it from home in 20 min a day\\n\\u2705 Backed by Dr. Blane Schilling\\n\\u2705 60-Results or Money Back Guarantee\\n\\u2705 FREE Shipping\\n\\nDon't fall into a dangerous medical procedure just because you have \\u201cno other options\\u201d.\\n\\nTry it risk-free today \\u2014 52\\u0025 off for a limited time.\\n\\nLearn more:  irries.com/iufb\"},\"cta_type\":\"LEARN_MORE\",\"display_format\":\"IMAGE\",\"link_description\":\"Irries\",\"link_url\":\"https://irries.com/products/irries-uni-fusion-belt?view=irries-uni-fusion-belt-sp\",\"images\":[{\"image_crops\":[],\"original_image_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/672672878_1963461204535761_7549066563802062740_n.jpg?_nc_cat=109&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=0nrhyNcKISIQ7kNvwGIjK-P&_nc_oc=AdrWJxEukHQH7VOG4wULKhQcKIBif2Eq1KjrOFJDN2vSLGneqZrYR2oXUkgPFET9Hwa2585EEYjd6aexN-sjxPPz&_nc_zt=14&_nc_ht=scontent.fdub8-1.fna&_nc_gid=DYn9GJzeujERi96M2I5Tlw&_nc_ss=7b2a8&oh=00_Af5MV-izrgFDAJmUjQu9RTXAFH3-X8d6uTKxdjT7mFMjzQ&oe=6A068935\",\"resized_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/671542647_2031006594115311_3188811935098070175_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=101&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=6Hv__Wdl8McQ7kNvwErp4Tr&_nc_oc=Adr2AklhFUz9R1jRGkPNZ1o-YQXQ275zLN8aH9pZ7poeOLwSYZ2F-Jy3aMK6dTI2Ezje-VBTywkPZUBKSlbpU46a&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=DYn9GJzeujERi96M2I5Tlw&_nc_ss=7b2a8&oh=00_Af5cmqZ90_K_CGJzZPcXaUvZsOzFe6_y_8ZEQ6qzJYjHxg&oe=6A068BE3\",\"watermarked_resized_image_url\":\"\"}],\"page_categories\":[\"Health & wellness website\"],\"page_like_count\":2061,\"title\":\"Try this before falling into sciatica surgery\",\"videos\":[],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"Irries\",\"impressions_with_index\":{\"impressions_text\":null,\"impressions_index\":-1},\"gated_type\":\"ELIGIBLE\",\"categories\":[\"UNKNOWN\"],\"is_aaa_eligible\":true,\"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778137200,\"publisher_platform\"