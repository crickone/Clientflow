cdn.net/v/t39.35426-6/672332891_1456694462848959_8109195227655682606_n.jpg?_nc_cat=103&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=NtxK32YxUg8Q7kNvwG3q_fN&_nc_oc=AdpPt3wIadaVMriPSGOSqrn_A1HkBU7zHpq1rUx57A0CdNjzuhyWGLPHH9nm98LNwv8dtrH8nX36HrN3yqKY8qz6&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=6-kTPdJNsTzJsSbLLp8ccA&_nc_ss=7b2a8&oh=00_Af4MiYBUY5QDqtGEZryEJPse6A4vr_lak1QElY-QnufKLQ&oe=6A067F93\",\"resized_image_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/671484037_1564865141791091_7110662836777976025_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=110&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=NxkeTdZxlqwQ7kNvwH2sJys&_nc_oc=AdoPzWcliHjgU35bjujQw0_5mlHW9jMkiKTc46U0UO0DK6oBYf8cCCkZJ4V3OLW48GdUGKJiWeMGr35KALHuXga1&_nc_zt=14&_nc_ht=scontent.fdub8-1.fna&_nc_gid=6-kTPdJNsTzJsSbLLp8ccA&_nc_ss=7b2a8&oh=00_Af4gHMSF5rIe_AzmgIxgEwCaP72sdx-COFsNPCnj73tgqg&oe=6A066706\",\"watermarked_resized_image_url\":\"\"}],\"page_categories\":[\"Health & Beauty\"],\"page_like_count\":4372,\"title\":\"5\\u0025 OFF Your First Order | WELCOME5\",\"videos\":[],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"Project E Beauty\",\"impressions_with_index\":{\"impressions_text\":null,\"impressions_index\":-1},\"gated_type\":\"ELIGIBLE\",\"categories\":[\"UNKNOWN\"],\"is_aaa_eligible\":true,\"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778396400,\"publisher_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"THREADS\"],\"start_date\":1778223600,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"1491380459694019\",\"collation_count\":1,\"collation_id\":\"1634923320782397\",\"page_id\":\"741212192419984\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"741212192419984\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/61581677066644/\",\"root_reshared_post\":null,\"byline\":\"\",\"disclaimer_label\":null,\"page_name\":\"Jennifer Lauren\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/672687252_958324083451793_7164729840345246101_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=100&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=Ohg7WumGHKcQ7kNvwG5tCjr&_nc_oc=Adp6eMUwyZNkb9EGOOdFF1T831Pwt62InCADTww3cNWbKSGshfsi0pg0fukFB9OgPegU--k-F6hym2W8_ZpSmGWv&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=6-kTPdJNsTzJsSbLLp8ccA&_nc_ss=7b2a8&oh=00_Af5huI851UVKS9C-rR8H2wKsZn3imDRhIMSmy91fovZ9mQ&oe=6A068768\",\"event\":null,\"caption\":\"groundingwell.com\",\"cta_text\":\"Learn more\",\"cards\":[],\"body\":{\"text\":\"I've been a personal assistant to a tech executive for seven years. Last month I accidentally found out his real secret. And honestly? I feel deceived. Because I've been struggling for two years and the answer was in his apartment the whole time.\\n\\nI need to start with me.\\n\\nBecause that's the part that makes this hurt.\\n\\nI'm 32. And for the last two years, I've felt like I'm falling apart.\\n\\nIt started with sleep. Getting into bed tired in my bones \\u2014 and just lying there. Brain buzzing. Body heavy but won't shut off. I'd pass out around midnight, wake at 2 AM, and spend the next three hours in that horrible in-between where you're not awake but you're not resting either.\\n\\nEvery morning. Stiff neck. Tight shoulders. A fog behind my eyes that doesn't lift until 10 AM. And even then it doesn't really lift. It just gets thin enough to function through.\\n\\nBy 2 PM I'm surviving on caffeine. By 6 PM I have nothing left. I've cancelled more evening plans in the last year than I've kept. Friends stopped asking. They just assume I'm not coming.\\n\\nI tried everything. Melatonin \\u2014 made me groggy, didn't keep me asleep. Magnesium \\u2014 nothing. CBD \\u2014 nothing. Weighted blanket. Blackout curtains. Sleep apps. Cutting caffeine after noon. Stretching before bed.\\n\\nNone of it worked.\\n\\nAnd at some point I stopped trying. I just accepted it. This is my 30s now. I'm a tired person. This is who I am.\\n\\nIf you're reading that and thinking \\\"that's me\\\" \\u2014 stay with me. Because what I found changes everything.\\n\\nNow let me tell you about my boss.\\n\\n54 years old. Runs a company. On calls from 6 AM to 8 PM. Flies cross-country twice a month. Under constant, crushing pressure.\\n\\nNever tired.\\n\\nNot \\\"pushing through\\\" tired. Genuinely, annoyingly, confusingly not tired. Same energy at 6 PM as 6 AM. Walks into a 7 AM meeting after a red-eye looking like he slept ten hours.\\n\\nI'm 32 and I'm done by lunch. He's 54 and he outworks everyone in the building.\\n\\nFor seven years I thought I knew why.\\n\\nBecause I run the machine.\\n\\n$400 a month in supplements I order. Functional medicine doctor I schedule. Trainer I book three times a week. Cold plunge. Infrared sauna. Red light therapy. Oura Ring. Whoop band.\\n\\n$15,000 a year on wellness. Every pill, every session, every gadget \\u2014 managed by me.\\n\\nI thought that's what bought him his energy. That the gap between us was money. He could afford to feel good. I couldn't.\\n\\nI was wrong. And finding out I was wrong is what made me feel deceived.\\n\\nLast month I was at his apartment stripping the bed. I noticed a thin cord from under the fitted sheet, plugged into the wall. I'd seen it a hundred times. Always assumed it was a heated pad or some gadget.\\n\\nThat day I pulled back the sheet. Underneath \\u2014 a soft fabric liner with a subtle shimmer. Connected to the wall.\\n\\nI took a photo. Didn't ask about it.\\n\\nTwo weeks later, Tokyo.\\n\\nHe forgot it.\\n\\nHe always packed it himself. A grey sheet rolled into his carry-on. Not on my packing list because I didn't know it existed.\\n\\nAnd without it, he fell apart.\\n\\nDay two \\u2014 late to a meeting. Three coffees by noon. Cancelled dinner.\\n\\nDay three \\u2014 couldn't find words mid-presentation. Short with everyone. Looked grey. Looked old.\\n\\nAnd I'm sitting there watching the most invincible person I've ever known crumble. And the thought that hits me is the one I can't get rid of:\\n\\nThat's how I feel. All the time. For two years.\\n\\nHe experienced two days of what I live with every single day. And it wrecked him.\\n\\nI asked what was wrong.\\n\\n\\\"Forgot my grounding sheet.\\\"\\n\\nHe explained it in 30 seconds. Silver woven into fabric. Plugs into the ground port in the wall \\u2014 connects to the earth. Pulls inflammation out through your skin while you sleep.\\n\\nThen he said the thing that made my stomach drop.\\n\\n\\\"Everything else is optimization. The sheet is the foundation. Without it, nothing else matters.\\\"\\n\\nSeven years. I managed $15,000 a year of wellness. Tracked every supplement. Scheduled every appointment. Maintained the entire system.\\n\\nAnd the foundation \\u2014 the one thing that actually mattered \\u2014 was under his fitted sheet. Plugged into his wall. And I didn't know it existed.\\n\\nI'd been making his bed for seven years and the answer to my two years of suffering was right there. Under the sheets I was changing every week.\\n\\nThat's why I feel deceived. Not by him. He didn't hide it. I just never asked. And nobody ever told me that the thing keeping a 54-year-old CEO sharper than a 32-year-old was something anyone could buy.\\n\\nI ordered GroundingWell that night.\\n\\nPlugged it in. Felt absurd. But I'd watched $15,000 worth of wellness crumble without a bedsheet. So I plugged it in.\\n\\nFirst night \\u2014 I slept. Real sleep. Woke up feeling like my body had actually been somewhere. Not just lying there.\\n\\nNight three \\u2014 2 AM came and went. I didn't wake up. First time in over a year.\\n\\nWeek two \\u2014 the neck and shoulders. The tightness I'd carried for years. One morning it just wasn't there anymore. Not reduced. Gone.\\n\\nWeek three \\u2014 brunch. My sister looked at me and said, \\\"What is different about you? You look rested. Actually rested. When's the last time that happened?\\\"\\n\\nI didn't have an answer. Because I couldn't remember.\\n\\nWeek four \\u2014 I realized I'd said yes to every plan that month. Dinner with friends. A movie on a Tuesday. Weekend plans I would have cancelled three months ago without thinking twice. I had energy at 7 PM. At 9 PM. I was living past 6 o'clock for the first time in two years.\\n\\nI spent two years thinking I was just a tired person. That something in me had broken. That this was my life now.\\n\\nIt wasn't. My body was inflamed and it couldn't repair itself at night. The sheet gave it what it needed. And the version of me I thought was gone came back.\\n\\nEight months now.\\n\\nI bought one for my mom. She's 58. Knees. Sleep. Stiffness every morning. I put it on her bed without telling her. Two weeks later she called: \\\"What did you do to my bed? My knees don't hurt. I'm sleeping. What is this?\\\"\\n\\nMy sister \\u2014 the brunch one \\u2014 texted after a week: \\\"I don't get it but I actually sleep now.\\\"\\n\\nBought a backup. Because GroundingWell sells out and I refuse to go back to who I was.\\n\\nAnd beware - Not all grounding sheets work. Friends bought cheap ones after I told them. Felt nothing. Because those sheets use silver coatings that wash off, or concentrations too low to conduct anything real. You're sleeping on regular cotton connected to nothing.\\n\\nGroundingWell has real silver woven into the fabric. Not coated. Woven. Doesn't wash off. Eight months in, mine works exactly like night one.\\n\\nSame brand my boss uses. The man who has access to every health tool money can buy and calls this the one thing he'd never give up.\\n\\nI spent two years thinking I was broken. That my 30s had taken something from me that wasn't coming back.\\n\\nI wasn't broken. I was uninformed.\\n\\nThe answer was under his fitted sheet. In his apartment. Where I worked every single day for seven years. And nobody \\u2014 not him, not any doctor, not any wellness brand \\u2014 ever told me it existed.\\n\\nI had to find a cord under a sheet, watch him forget it on a trip, and see a $15,000 wellness routine collapse without it before I figured it out.\\n\\nYou don't have to do it that way. You just found out.\\n\\n90-day guarantee. Three full months. If you don't feel it, send it back.\\n\\nBut nobody sends it back. They order one for their mom. Their sister. Their husband. Because once you feel the difference, you can't unfeel it.\\n\\nThey're running a sale right now. They're small. Real silver costs more. They sell out.\\n\\nIf they're in stock \\u2014 don't wait.\\n\\nI waited seven years because nobody told me. Now I'm telling you.\\n\\nIt was under his sheets. The whole time.\\n\\nLink is below. Make sure it's GroundingWell. The cheap ones don't have real silver.\\n\\nhttps://www.groundingwell.com/products/groundingwell-bedsheet\"},\"cta_type\":\"LEARN_MORE\",\"display_format\":\"IMAGE\",\"link_description\":\"The GroundingWell\\u2122 Bedsheet channels Earth's electrons into your body, promoting deeper sleep, reduced stress, and faster healing while you rest.\",\"link_url\":\"https://www.groundingwell.com/products/groundingwell-bedsheet\",\"images\":[{\"image_crops\":[],\"original_image_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/674955987_1255319496771856_3908698372421995406_n.jpg?_nc_cat=108&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=v3nk0ie_OQcQ7kNvwGqLG9j&_nc_oc=Adqr6Mg7XAm360dSHP1ntV4w5UTzYGYzKhZNuwcRSZciLR7I4s2_hwqE1iGH2E53gDJ4xv3AGx83A-vjCwkH82jr&_nc_zt=14&_nc_ht=scontent.fdub8-1.fna&_nc_gid=6-kTPdJNsTzJsSbLLp8ccA&_nc_ss=7b2a8&oh=00_Af608qJ_rM-Gu9-x-cnHlaIgJY2I3kw7XVxPQo19u7AYiw&oe=6A066EC9\",\"resized_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/671925666_1371481881453590_2127514579017997316_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=103&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=_XLgpmYH3NwQ7kNvwF5oexx&_nc_oc=AdpmG5LeQsidF5m-I7_vMuaVr0N4N0QKtCk0Y8BeyGZniLDQgvyQ0N2DyIhc6iApixhO54D2LQ_80LPm5MdRdFZB&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=6-kTPdJNsTzJsSbLLp8ccA&_nc_ss=7b2a8&oh=00_Af4bY02YEb3haep22lQTaA_vxmS6bRdfIT4iAh2pN78fkQ&oe=6A06621F\",\"watermarked_resized_image_url\":\"\"}],\"page_categories\":[\"Digital Creator\"],\"page_like_count\":477,\"title\":\"Get Grounded While You Sleep!\",\"videos\":[],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"Jennifer Lauren\",\"impressions_with_index\":{\"impressions_text\":\"\\u003C100\",\"impressions_index\":0},\"gated_type\":\"ELIGIBLE\",\"categories\":[\"UNKNOWN\"],\"is_aaa_eligible\":true,\"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778310000,\"publisher_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"AUDIENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1776409200,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"26728466920148540\",\"collation_count\":1,\"collation_id\":\"4429038784044150\",\"page_id\":\"100199106121016\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"100199106121016\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/100083668906509/\",\"root_reshared_post\":null,\"byline\":null,\"disclaimer_label\":null,\"page_name\":\"Laugh and Share\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/680444095_1640771403708292_402685823190538271_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=104&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=sDucNz_txsQQ7kNvwHvSQXQ&_nc_oc=Adqtql4rrBc1_HfPwPJWbC7Am8G7_2_UgQT3wylMqSq1LavlmPV8ToKqt1g-W1JWdMI-N_FlD9BeRQkSlewYJ2fP&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=6-kTPdJNsTzJsSbLLp8ccA&_nc_ss=7b2a8&oh=00_Af5glkbkxah08N9dg5SV3ORJDg6tE4LAvUWRjaDYOHvckA&oe=6A0672BA\",\"event\":null,\"caption\":\"secure.glowfreedoms.com\",\"cta_text\":\"Shop now\",\"cards\":[],\"body\":{\"text\":\"\\ud83d\\udd2c Your Morning Hand Stiffness Is Not An Arthritis Symptom. It Is A Circulation Symptom. \\ud83d\\udd2c\\n58 million Americans have been told the same thing: morning stiffness is a symptom of arthritis. It's expected. It's manageable. \\ud83d\\udcab\\nWhat almost none of them have been told: morning hand stiffness is not primarily a joint symptom. It's a circulation symptom. The joint isn't more damaged overnight \\u2014 it's more poorly supplied with blood. \\u2728\\nCompression gloves address fluid pressure around the joint. Far infrared addresses blood flow into it. Those are two completely different problems \\u2014 and for 70 years, the entire industry has only been treating one. \\ud83e\\ude7a\\nInfraFlex\\u2122 combines both mechanisms in one glove. Immediate compression relief. Continuous FIR circulation improvement. The effect continues after you take it off. \\ud83d\\udc9b\\n$39. 90-day guarantee. Treat the right problem \\ud83d\\udc49 https://secure.glowfreedoms.com/infraflex/139/adv/v2\"},\"cta_type\":\"SHOP_NOW\",\"display_format\":\"VIDEO\",\"link_description\":\"Morning hand stiffness is not primarily a joint symptom \\u2014 it's a circulation symptom. The joint isn't more damaged overnight. It's more poorly supplied with blood. That distinction changes everything about how you treat it\",\"link_url\":\"https://secure.glowfreedoms.com/infraflex/139/adv/v2\",\"images\":[],\"page_categories\":[\"Topic\"],\"page_like_count\":981,\"title\":\"Your Morning Hand Stiffness Is Not An Arthritis Symptom. It Is A Circulation Symptom.\",\"videos\":[{\"video_hd_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/o1/v/t2/f2/m366/AQPoskHJ8Jff2bh4YMr2C9WNA0gERLmjBK5e3yjrGfJgL6C03cpd_WmaLXsw-bOjgABBpjFHSg0cThCa1YXH3wpijAkdOMIUdj5ihT-VnNAgqw.mp4?_nc_cat=100&_nc_oc=AdrLm5nqv67s8tGYuvIa_iFhtcAAMpFoMIAFfvW0nxgZnuJ35ljTDxU8OCy4sytKUrI7wIZFLkQrogsz5yzi48DL&_nc_sid=5e9851&_nc_ht=scontent.fdub4-2.fna.fbcdn.net&_nc_ohc=dr5KKsTmUygQ7kNvwGPK5CF&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5WSV9VU0VDQVNFX1BST0RVQ1RfVFlQRS4uQzMuNzIwLmRhc2hfaDI2NC1iYXNpYy1nZW4yXzcyMHAiLCJ4cHZfYXNzZXRfaWQiOjE0OTE0NTcyMDkyMjEyNzYsImFzc2V0X2FnZV9kYXlzIjoxMywidmlfdXNlY2FzZV9pZCI6MTAxMzksImR1cmF0aW9uX3MiOjEzMiwidXJsZ2VuX3NvdXJjZSI6Ind3dyJ9&ccb=17-1&vs=5b2dcd0c06856ef8&_nc_&_nc_gid=6-kTPdJNsTzJsSbLLp8ccA&_nc_ss=7b2a8&_nc_zt=28&oh=00_Af4aFcb1P6Zg1obnfeTd6j4e1LPwNMKimLM41kepKAqyog&oe=6A065D80\",\"video_preview_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/679860090_1468752034989225_5632730233661125210_n.jpg?_nc_cat=106&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=iZ9UfyvPWmwQ7kNvwFFSxaD&_nc_oc=AdrZdyaILoIMhxjNPwvGzjJFinVJMFOxfZo8xsouHkkAU44pm4jeUw0YzVZ_FE8tBwfIqw3LTBF3pjh5_ZCJ9DzP&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=6-kTPdJNsTzJsSbLLp8ccA&_nc_ss=7b2a8&oh=00_Af4JjH39hSHz5lRvaNV3F6hPkvjAPXctoE99k8S_Rn7hSg&oe=6A067ED3\",\"video_sd_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/o1/v/t2/f2/m412/AQPp7p5Zeb8V6DLHdQaAvE6Z7HUG6xLDCI5ZmZ0f5Pl2YneTzddSX2mF4tBs74kkQPTrczVFuMLJ_H5YopgdEQ-RGLDSBaUXyjlVr6ljjA.mp4?_nc_cat=109&_nc_oc=AdrRO-wrAcZyjI6aTSHOpm42LXNcDHMXWewDAwb3aDAX5sLAs0s7__GlThyTuoCn9WdGuG48d-iDS7cC3frkFNwn&_nc_sid=8bf8fe&_nc_ht=scontent.fdub8-1.fna.fbcdn.net&_nc_ohc=xaOfUtt7e6QQ7kNvwEOHM9D&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5WSV9VU0VDQVNFX1BST0RVQ1RfVFlQRS4uQzMuMzYwLnN2ZV9zZCIsInhwdl9hc3NldF9pZCI6MTQ5MTQ1NzIwOTIyMTI3NiwiYXNzZXRfYWdlX2RheXMiOjEzLCJ2aV91c2VjYXNlX2lkIjoxMDEzOSwiZHVyYXRpb25fcyI6MTMyLCJ1cmxnZW5fc291cmNlIjoid3d3In0\\u00253D&ccb=17-1&_nc_gid=6-kTPdJNsTzJsSbLLp8ccA&_nc_ss=7b2a8&_nc_zt=28&oh=00_Af4SKKgVVhkblNRKC2BPjwEGZHNCT9P3yuMph7uje8DXfw&oe=6A067DDD\",\"watermarked_video_hd_url\":null,\"watermarked_video_sd_url\":null}],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"Laugh and Share\",\"impressions_with_index\":{\"impressions_text\":\"\\u003C100\",\"impressions_index\":0},\"gated_type\":\"ELIGIBLE\",\"categories\":[\"UNKNOWN\"],\"is_aaa_eligible\":true,\"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778310000,\"publisher_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"AUDIENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1778137200,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id