er_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"AUDIENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1773212400,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"3195377373993584\",\"collation_count\":1,\"collation_id\":\"1645839453206958\",\"page_id\":\"107475438935077\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"107475438935077\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.instagram.com/_u/seomrasalainnwellnesscentre\",\"root_reshared_post\":null,\"byline\":null,\"disclaimer_label\":null,\"page_name\":\"seomrasalainnwellnesscentre\",\"page_profile_picture_url\":\"https://scontent.cdninstagram.com/v/t51.82787-19/610515890_18059155376647133_7242498096101849078_n.jpg?stp=dst-jpg_s206x206_tt6&_nc_cat=102&ccb=7-5&_nc_sid=525117&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4zMjQuQzMifQ\\u00253D\\u00253D&_nc_ohc=bU10xdX2lEoQ7kNvwGI2CK7&_nc_oc=Adohz6zIPoIdx46RYp5yKeSkRTqIEqFmZgW9hr_1YvtTmUiga9Whxhcy4xz44pR4qp-0VfSoQWZuOCU7d6bfePZs&_nc_zt=24&_nc_ht=scontent.cdninstagram.com&_nc_gid=YYXzXCQhVFgo9vcsCVpIqA&_nc_ss=7b2a8&oh=00_Af7F0-77SXlEFDTqvRfDyuAcP06mugNCYfHVwQLDlcuaqw&oe=6A066E45\",\"event\":null,\"caption\":\"instagram.com\",\"cta_text\":\"Visit Instagram profile\",\"cards\":[],\"body\":{\"text\":\"When it comes to treating and preventing conditions like Asthma, Sinus issues, Spring Allergies, and those lingering colds & coughs, the science behind Salt Therapy is truly remarkable. Let's delve into the details:\\n\\n1. Asthma: Salt Therapy works wonders by reducing inflammation in the airways. The microscopic salt particles inhaled during a session help soothe irritated bronchial passages, making breathing easier for individuals with Asthma.\\n\\n2. Sinus Troubles: Those pesky sinus issues often involve congestion and inflammation. Salt Therapy acts as a natural decongestant, thinning out mucus and reducing inflammation in the sinuses. This not only alleviates discomfort but also helps promote better sinus health.\\n\\n3. Summer Allergies: Salt Therapy's antimicrobial properties make it a game-changer for managing Spring allergies. It helps combat allergens in the respiratory system, offering relief from sneezing, congestion, and itchy eyes.\\n\\n4. Colds / Coughs: Salt Therapy can bolster your immune system, but it goes even further. The salt draws moisture out of viruses, which can essentially dehydrate and neutralize them. This process can help your body's defences fight off potential illnesses like the Colds/Coughs which we see all year round now.\\n\\nRemember, the maintenance sessions in Salt Therapy are crucial, even when you're feeling in the pink of health. They serve as a proactive approach, maintaining respiratory wellness throughout the winter.\\n\\nAnd if TIME POOR, try HaloRed exclusive to Seomra Salainn, this is a high intensity Red Light Therapy session with Salt Therapy & Near Infrared, a true game changer for your Spring Wellness & Recovery. and its only a 15 minute session.\\n\\nBook your session at\\nwww.seomrasalainn.com\\n\\nTo get a better understanding of what we do you can DM us, check out www.seomrasalainn.com, Complete our Website enquiry form,\\nemail us at info\\u0040seomrasalainn.com\\nOr\\nCall 0861081238, we look forward to hearing from you!\\n\\n#SeomraSalainnWellnessCentre #adult #hayfever # performance # sinusitis #dublin #allergicrhinitis #allergies #relief #sports #wheezing #cough #chestinfection #COPD #salttherapy #redlighttherapy #naturaltherapy #asthma #sinusitis\"},\"cta_type\":\"VIEW_INSTAGRAM_PROFILE\",\"display_format\":\"IMAGE\",\"link_description\":null,\"link_url\":\"http://instagram.com/seomrasalainnwellnesscentre\",\"images\":[{\"image_crops\":[],\"original_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/687052519_1695202481472395_577665427517639147_n.jpg?_nc_cat=105&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=NzKRXH-DkVIQ7kNvwF1S0wf&_nc_oc=AdpYohrsFGgxQvqD6qBD7I1gSLq4RUigWFcojho5taUOZRiDZ9t_8HrIk-Oq8mgmlFMDfONG4whwpUd2pzeOZxoI&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=YYXzXCQhVFgo9vcsCVpIqA&_nc_ss=7b2a8&oh=00_Af5101Qm6o8o0m97Zjrznvk0vGd4LjmTCbpk6e8adN11iQ&oe=6A0682F1\",\"resized_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/692383288_1870110120335499_77770671924729028_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=103&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=A-8eb4VbJEQQ7kNvwGf_IKW&_nc_oc=Adoa7s8bHsJpS-JSypVvrr5ZKdGiKP979ZSqSEYx4pLHea5-9yWfUwgS-lQeTbgiocO1frJorqhTzbiyOQtVJU4y&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=YYXzXCQhVFgo9vcsCVpIqA&_nc_ss=7b2a8&oh=00_Af7NJ2dTUSdGiUCoAJo1ssAWD_16GzU_4KjJfgT7cuSbbg&oe=6A067D1D\",\"watermarked_resized_image_url\":\"\"}],\"page_categories\":[\"Profile\"],\"page_like_count\":0,\"title\":null,\"videos\":[],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"seomrasalainnwellnesscentre\",\"impressions_with_index\":{\"impressions_text\":null,\"impressions_index\":-1},\"gated_type\":\"ELIGIBLE\",\"categories\":[\"UNKNOWN\"],\"is_aaa_eligible\":true,\"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778396400,\"publisher_platform\":[\"INSTAGRAM\"],\"start_date\":1778050800,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":fa