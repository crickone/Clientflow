page_id\":\"107475438935077\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"107475438935077\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.instagram.com/_u/seomrasalainnwellnesscentre\",\"root_reshared_post\":null,\"byline\":null,\"disclaimer_label\":null,\"page_name\":\"seomrasalainnwellnesscentre\",\"page_profile_picture_url\":\"https://scontent.cdninstagram.com/v/t51.82787-19/610515890_18059155376647133_7242498096101849078_n.jpg?stp=dst-jpg_s206x206_tt6&_nc_cat=102&ccb=7-5&_nc_sid=525117&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4zMjQuQzMifQ\\u00253D\\u00253D&_nc_ohc=bU10xdX2lEoQ7kNvwGI2CK7&_nc_oc=Adohz6zIPoIdx46RYp5yKeSkRTqIEqFmZgW9hr_1YvtTmUiga9Whxhcy4xz44pR4qp-0VfSoQWZuOCU7d6bfePZs&_nc_zt=24&_nc_ht=scontent.cdninstagram.com&_nc_gid=YYXzXCQhVFgo9vcsCVpIqA&_nc_ss=7b2a8&oh=00_Af7F0-77SXlEFDTqvRfDyuAcP06mugNCYfHVwQLDlcuaqw&oe=6A066E45\",\"event\":null,\"caption\":\"instagram.com\",\"cta_text\":\"Visit Instagram profile\",\"cards\":[],\"body\":{\"text\":\"Delighted to add another exciting Touchlesss Therapy to our facilities, we feel this is again a \\\"Gamer changer\\\" for some many of our clients in assisting with their Wellness is a natural way.\\n\\nWhat is Pressotherapy?\\n\\nits a gentle, non-invasive treatment that uses air pressure to gentle massage your body, a soothing rhythmic hug for your whole body\\n\\nAre you feeling bloated, heavy, or just fatigued, this is the therapy you have been waiting for. Its a lymphatic drainage massage suit that uses gentle air pressure to help stimulate your lymphatic system, assisting Detox, increased circulation, leaving you feeling lighter, energized and body balanced.\\n\\nThe main benefits are;\\n\\nReduces water retention and swelling.\\nImproves circulation and recovery\\nEases muscle tension.\\nBoosts lymphatic drainage.\\nDetoxes the body.\\n\\nWatch out for more details on the benefits and who this therapy is for.\\n\\nBook your session at\\nwww.seomrasalainn.com\\n\\nTo get a better understanding of what we do you can DM us, check out www.seomrasalainn.com, Complete our Website enquiry form,\\nemail us at info\\u0040seomrasalainn.com\\nOr\\nCall 0861081238, we look forward to hearing from you!\\n\\n#pressotherapy, #lymphaticdrainage, #bodycontouring, #DetoxTreatment #SeomraSalainnWellnessCentre #adult #children #hayfever # performance # sinusitis #dublin #allergicrhinitis #allergies #relief #sports #wheezing #cough #chestinfection #COPD #salttherapy #eczema #acne #inflammation #antiaging #redlighttherapy #fibrosis #bonehealth #pain #musclerepair #infrared #oxygentherapy\"},\"cta_type\":\"VIEW_INSTAGRAM_PROFILE\",\"display_format\":\"IMAGE\",\"link_description\":null,\"link_url\":\"http://instagram.com/seomrasalainnwellnesscentre\",\"images\":[{\"image_crops\":[],\"original_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/688888044_2426604887833986_5461450916434459231_n.jpg?_nc_cat=105&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=okGSUmq516QQ7kNvwHyepKX&_nc_oc=AdrCeYm-BOLM32ZifGieB1H_6glN6CSLjIDNuen4m2IUI_xCnIFsf3OzkaQM7Jh0i9t1f1dzMMKqlEOHmcHBF9QW&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=YYXzXCQhVFgo9vcsCVpIqA&_nc_ss=7b2a8&oh=00_Af7D6dOnFIUH_q1auB_TgKdMWp0H8C3Co9sHpTDDUvITnw&oe=6A0663E8\",\"resized_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/689482456_1690247578836440_5766807539122224380_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=106&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=QyBNflbWb6EQ7kNvwFXZtg0&_nc_oc=Adr6WGFMbGeecfb1Bs2nYTQcH5uSCQOMzL-gVFrqGysltU5apwpcEKjnt7f5Jl_3rCoIeqUDnEvQ6irds9cayOO7&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=YYXzXCQhVFgo9vcsCVpIqA&_nc_ss=7b2a8&oh=00_Af4Fo-DnylzNOFeD9NBYYxXhAOovihXf5EkTsAiwrKyjAA&oe=6A0683B5\",\"watermarked_resized_image_url\":\"\"}],\"page_categories\":[\"Profile\"],\"page_like_count\":0,\"title\":null,\"videos\":[],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":n