K\",\"MESSENGER\",\"THREADS\"],\"start_date\":1764057600,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"2125323008247448\",\"collation_count\":1,\"collation_id\":\"2040113453386742\",\"page_id\":\"343534518849003\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"343534518849003\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/61562061955567/\",\"root_reshared_post\":null,\"byline\":\"\",\"disclaimer_label\":null,\"page_name\":\"Irries\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/670632691_2136305203794738_4613100475428072284_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=106&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=5zpKrCsqSgMQ7kNvwGa10yp&_nc_oc=AdrtvC279jPJFWUYhccZcJa3anm4cLhjUvhYi63vdzbOyn0hjwd1gQizQAoul2TBfPK4sVKeHLXvEpf3h5cBcUiN&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=xYj0uHfXfaEUd15JPmcclQ&_nc_ss=7b2a8&oh=00_Af73O2FW4v1Rew96wxzAHGsnWyFJGhQvRtCFMy4ynNPHPA&oe=6A067AAB\",\"event\":null,\"caption\":\"irries.com\",\"cta_text\":\"Shop now\",\"cards\":[],\"body\":{\"text\":\"\\ud83d\\udea8 Sciatica? Think twice before going under the knife\\u2026 \\u274c\\n\\nEnd sciatic pain with the groundbreaking new Uni Fusion Technology.\\n\\nYour disc is the foundation of your movement \\u2014 but when pain keeps coming back, it can feel like your body is broken beyond repair\\u2026\\n\\nIgnore it too long, and the damage only gets worse.\\nBut before you book that surgery \\u2014 there's something your surgeon probably hasn't told you.\\n\\nYour herniated disc can heal itself, naturally.\\n\\nStudies show a process called \\\"spontaneous disc resorption\\\" allows your disc to retract away from the nerve on its own.\\n\\nThe reason it hasn't happened yet? Your disc hasn't had the right environment to activate it.\\n\\nIntroducing the Irries \\\"Uni Fusion\\\" Belt \\u2014 the first device that activates your disc's natural healing ability in just 20 minutes a day.\\n\\nThis breakthrough device combines four clinically backed therapies to target your sciatica at the source:\\n\\n\\ud83d\\udc49 Mechanical Decompression\\n\\ud83d\\udc49 Soothing Heat Therapy\\n\\ud83d\\udc49 BiWave Light Therapy (Near-Infrared + Red Light)\\n\\ud83d\\udc49 Deep Tissue Massage\\n\\nJust 20 minutes a day from the comfort of your home can make a huge difference.\\n\\nUsers report significant relief in as little as 2\\u20133 weeks of daily use\\u2026\\n\\nReady to get your life back?\\n\\nTry the Irries \\\"Uni Fusion\\\" Belt completely risk-free today:\\n\\n\\u2705 Addresses the real reason everything failed\\n\\u2705 Saves you from surgery\\n\\u2705 4 therapies in 1 device\\n\\u2705 Use it from home in 20 min a day\\n\\u2705 Backed by Dr. Blane Schilling\\n\\u2705 60-Results or Money Back Guarantee\\n\\u2705 FREE Shipping\\n\\nDon't let sciatica push you into a procedure you may not need.\\n\\nTake the first step toward pain-free living now.\\n\\nLearn more: irries.com/m-iufb-adv-st-1\"},\"cta_type\":\"SHOP_NOW\",\"display_format\":\"VIDEO\",\"link_description\":null,\"link_url\":\"https://irries.com/m-iufb-adv-st-1\",\"images\":[],\"page_categories\":[\"Health & wellness website\"],\"page_like_count\":2061,\"title\":\"Try this before falling into sciatica surgery...\",\"videos\":[{\"video_hd_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/o1/v/t2/f2/m366/AQNZqbO39EIuAvBj0D2aOLFnWEQB8SsQPzxYEk4YipBh1RqUt7WYax0jGgx57FA9O9PmM95y0FHVykHEpGNLwEa90GuG51YOKxo_LrzMwPUPUw.mp4?_nc_cat=111&_nc_oc=AdoI3hv5XIwdiid9LxJCGwETa-Fd_K7kOnziP58eIqzSPfM3Jbqeg8jv36jZAkNwuDvA1lZbQpyvGcIh8m0QzYnC&_nc_sid=5e9851&_nc_ht=scontent.fdub8-1.fna.fbcdn.net