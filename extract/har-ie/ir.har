scontent.fdub4-2.fna.fbcdn.net/o1/v/t2/f2/m412/AQO24QPp29IDUvgtJBm5m9N4UbSbte-x_Qc_MSWuzmklVLTReTLDTOrKIJqXSRRsBW5ZlUPgoHtCvDg_A8VKY2sds8ZDpvBi2kJ2QbV-0A.mp4?_nc_cat=102&_nc_oc=AdqJYTiponGs8dzB4j7GPTbo3P4BLXU-6dfP2pUbyWr0T36YWLV6rBPRW4l2zmx08kJ0FX_1XdBEe3-SpeKRDWkR&_nc_sid=8bf8fe&_nc_ht=scontent.fdub4-2.fna.fbcdn.net&_nc_ohc=wiK4f8vxRHsQ7kNvwHaK86g&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5WSV9VU0VDQVNFX1BST0RVQ1RfVFlQRS4uQzMuMzYwLnN2ZV9zZCIsInhwdl9hc3NldF9pZCI6MTI5NzMyODY0ODk5NTgyOSwiYXNzZXRfYWdlX2RheXMiOjI3LCJ2aV91c2VjYXNlX2lkIjoxMDc5OSwiZHVyYXRpb25fcyI6MjAsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ\\u00253D\\u00253D&ccb=17-1&_nc_gid=YYXzXCQhVFgo9vcsCVpIqA&_nc_ss=7b2a8&_nc_zt=28&oh=00_Af4bDP9c-ZcaicK4HpJ0v5_rTXibaL-Qt_sxMYV4nprMDw&oe=6A067900\",\"watermarked_video_hd_url\":null,\"watermarked_video_sd_url\":null,\"image_crops\":[],\"original_image_url\":null,\"resized_image_url\":null,\"watermarked_resized_image_url\":null}],\"body\":{\"text\":\"Are you a skincare professional looking to retail trusted, clinically proven devices?\\n\\nDon\\u2019t let other retailers sell your clients at-home devices.\\nMake sure what they\\u2019re investing in is effective, professional-grade, and certified as a safe device\\u2014not just another trend.\\n\\nOur advanced LED technology uses validated wavelengths to deliver real, professional-grade results your clients can achieve at home.\\n\\nAt-home devices are one of the fastest-growing trends in skincare right now\\u2014and your clients are already looking for them. The question is\\u2026 will they buy from you, or somewhere else?\\n\\nThis is your opportunity to offer a device that is:\\n\\u2728 Clinically proven\\n\\u2728 Professional-grade\\n\\u2728 Globally certified \\n\\u2728 Safe, effective, and results-driven\\n\\u2728 Supported with a professional dose guide, so your clients can use it correctly, safely, and in line with professional protocols\\n\\nPosition yourself as the expert. Keep your clients within your business. Offer them technology you trust.\"},\"cta_type\":\"LEARN_MORE\",\"display_format\":\"CAROUSEL\",\"link_description\":null,\"link_url\":\"http://fb.me/\",\"images\":[],\"page_categories\":[\"Product/service\",\"Health & Beauty\",\"Health/beauty\"],\"page_like_count\":1172,\"title\":\"Louisa Webb Aesthetic Solutions\",\"videos\":[],\"is_reshared\":false,\"extra_links\":[\"https://lwaestheticdevices.com/lw-silicon-led-mask\",\"tel:+447900901486\"],\"extra_texts\":[{\"text\":\"Be Part of the Fastest-Growing Skincare Trend\"},{\"text\":\"This is for skin professionals only. If you\\u2019re ready to bring a clinically proven device into your clinic, enquire below.\"},{\"text\":\"Please provide your name and email, and someone will be in touch.\"},{\"text\":\"How soon are you looking to buy?\"},{\"text\":\"Just browsing\"},{\"text\":\"ASAP\"},{\"text\":\"Within the next 1\\u20133 months\"},{\"text\":\"Within the next 3\\u20136 months\"},{\"text\":\"6+ months\"},{\"text\":\"Are you the salon owner or the primary decision-maker for purchases?\"},{\"text\":\"Yes\"},{\"text\":\"No\"},{\"text\":\"What type of skin professional are you?\"},{\"text\":\"Doctor\"},{\"text\":\"Beauty Therapist\"},{\"text\":\"Aesthetic Practitioner\"},{\"text\":\"Nurse\"},{\"text\":\"Email\"},{\"text\":\"Full name\"},{\"text\":\"Phone number\"},{\"text\":\"Inbox URL\"},{\"text\":\"Terms and Conditions for Louisa Webb Aesthetic Solutions\"},{\"text\":\"Visit Louisa Webb Aesthetic Solutions's Privacy Policy.\"},{\"text\":\"Thanks, you're all set.\"},{\"text\":\"We can\\u2019t wait to welcome you to the fastest-growing retail opportunity.\"}],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"Louisa Webb Aesthetic Solutions\",\"impressions_with_index\":{\"impression