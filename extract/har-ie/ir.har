geted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"920481340805625\",\"collation_count\":1,\"collation_id\":\"904530972177258\",\"page_id\":\"864840870048453\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"864840870048453\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/61582674766771/\",\"root_reshared_post\":null,\"byline\":null,\"disclaimer_label\":null,\"page_name\":\"Optimal Health & Recovery at Inspire\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/666669447_2407639613037486_1711706002913586800_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=102&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=BwnAeWBuPE8Q7kNvwEf1Pzr&_nc_oc=Adov37kUAI0QLIjF6un9lsT3KkZsOMLYEoS5joxoAFjVBFXRQoQDB-zYBXRBHzv7a5HQKwHk1EOsKpTk8YuCksfc&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=3RYrHKp-JWVepgQ1WrR1fQ&_nc_ss=7b2a8&oh=00_Af5jj1HsfmcXzF3PaMVTtHoKX51IJ8B1YrEXva4QAbKNZQ&oe=6A068233\",\"event\":null,\"caption\":\"fb.me\",\"cta_text\":\"Sign up\",\"cards\":[],\"body\":{\"text\":\"When Sean came to see us at Optimal Health & Recovery, he was looking for a way to break the cycle of inflammation. After just 10 sessions in our Infrared Therapy bed, his symptoms have cleared up completely.\\n\\nCostochondritis can be a debilitating and painful condition that often resists traditional treatments. It inflames the cartilage connecting the ribs to the breastbone.\\n\\nThe Science: Infrared light penetrates up to 3 inches into the body, reaching the deep cartilage and connective tissue that standard treatments often miss. By boosting cellular ATP and increasing micro-circulation, it allows the body to \\\"cool\\\" the inflammatory fire and repair at a cellular level.\\n\\nDon\\u2019t just manage the pain. Resolve it.\\n\\nSo if you\\u2019re struggling with a chronic condition and haven't found the relief you need, it's time to try a different approach. \\n\\nClick the link below and let\\u2019s get you back to your best.\\n\\nOptimal Health & Recovery \\ud83d\\udccd Unit 12m, Ard Gaoithe Business Park, Clonmel. \\ud83d\\udcde 083 867 2844\"},\"cta_type\":\"SIGN_UP\",\"display_format\":\"VIDEO\",\"link_description\":\"Infrared Therapy\",\"link_url\":\"http://fb.me/\",\"images\":[],\"page_categories\":[\"Health & wellness website\"],\"page_like_count\":1100,\"title\":\"How Infrared Therapy Cured Sean's Chest Pain\",\"videos\":[{\"video_hd_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/o1/v/t2/f2/m366/AQO7iRi7ikATvmOcAPOahmJe1at-Vkw4cwRt8l2kfdbYBOudLjTv9mGuUqY5Oy9sYwG9aD0yDvSw9OxVm-nk6bGUcEO8ZYweQbcnlFYRGpIEXg.mp4?_nc_cat=106&_nc_oc=AdrOREnUkt6LfVG5VEb1OYeHmwCTvG-uVTWeZu7H-dFFuIkKMMf1ZopHMpXtxiZxORUioOWLdd65TDHdjdBs7HhS&_nc_sid=5e9851&_nc_ht=scontent.fdub4-2.fna.fbcdn.net&_nc_ohc=3nzjsN73ba4Q7kNvwFaD4OZ&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5WSV9VU0VDQVNFX1BST0RVQ1RfVFlQRS4uQzMuNzIwLmRhc2hfaDI2NC1iYXNpYy1nZW4yXzcyMHAiLCJ4cHZfYXNzZXRfaWQiOjE4MjgxMjUwNjQ1MDcwMTUsImFzc2V0X2FnZV9kYXlzIjoxNDcsInZpX3VzZWNhc2VfaWQiOjEwMTIyLCJkdXJhdGlvbl9zIjoxMDgsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ\\u00253D\\u00253D&ccb=17-1&vs=d6d75f33f334e145&_nc_vs=HBksFQIYRWZiX2VwaGVtZXJhbC84RTRFNzZFODBBRDFCMjQ3QTM0NjBCOTVEOTg2Njk4N19tdF8xX3ZpZGVvX2Rhc2hpbml0Lm1wNBUAAsgBEgAVAhhAZmJfcGVybWFuZW50L0IyNDlDNUNBMTM1MzIzQTE3NEM5N0ZFREQ2RDE2MjlDX2F1ZGlvX2Rhc2hpbml0Lm1wNBUCAsgBEgAoABgAGwKIB3VzZV9vaWwBMRJwcm9ncmVzc2l2ZV9yZWNpcGUBMRUAACaOupmR8aq_BhUCKAJDMywXQFsZmZmZmZoYGWRhc2hfaDI2NC1iYXNpYy1nZW4yXzcyMHARAHUAZZSeAQA&_nc_gid=3RYrHKp-JWVepgQ1WrR1fQ&_nc_ss=7b2a8&_nc_zt=28&oh=00_Af76k0q7DRa5FxRazq06km_wlzPvaKOQEgyDImtGbWi4cw&oe=6A066AFE\",\"video_preview_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/666494344_2276295496231418_6382336650598654876_n.jpg?_nc_cat=103&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=R1Bw8UPPwxAQ7kNvwEb5buy&_nc_oc=AdpqjwI47DaDMluXJnKau0qi8dlx9vGGfMR_CSBnyTsuqQGHsxoEbJVo6vv6flzrywetWmRMApXwBQTHsls6wHze&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_