\"HealRay\",\"impressions_with_index\":{\"impressions_text\":null,\"impressions_index\":-1},\"gated_type\":\"ELIGIBLE\",\"categories\":[\"UNKNOWN\"],\"is_aaa_eligible\":true,\"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778396400,\"publisher_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"AUDIENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1777964400,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"1488880402755800\",\"collation_count\":1,\"collation_id\":\"1008100561152161\",\"page_id\":\"105376007677641\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"105376007677641\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/symbyxbiome/\",\"root_reshared_post\":null,\"byline\":null,\"disclaimer_label\":null,\"page_name\":\"Symbyx Biome\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/656111788_1294990705818292_5098710808838167399_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=106&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=iELFgSxmgAAQ7kNvwHclRhz&_nc_oc=AdrGb7zV946L3MFEAtTxBPFVUeUfokj6yBQ6uQsp3ya-GJuz_mEvWGbtkdLtDRkhD-1SWHvHphSUHTX1wLcOc2a1&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=ruwhb5-fBE7aW_1pM4I7Tg&_nc_ss=7b2a8&oh=00_Af7oDNsjdAbQ1DArcRkKFJ6J7O79BvfCC-FXFUwdJUVN3A&oe=6A067E6A\",\"event\":null,\"caption\":\"symbyxbiome.com\",\"cta_text\":\"Shop now\",\"cards\":[],\"body\":{\"text\":\"Inspired by over two decades of research, our Australian-designed helmet is meticulously crafted to boost cognitive function and mental acuity to aid in overall general wellbeing and ensure you get the best possible outcome.\\n \\n\\ud83c\\udfe1 Easy, no-fuss therapy that preserves independence and quality of life.\\n \\n\\u23f1 Just 24 minutes a day, up to 5 days a week to start feeling more energised.\\n \\nTry the SYMBYX Neuro today!\\nsymbyxbiome.com/products/symbyx-neuro\\n\\n \\n*The SYMBYX Neuro is classified for general wellness only, not for medical use. The information provided is not medical advice. Consult a doctor for any medical concerns.\"},\"cta_type\":\"SHOP_NOW\",\"display_format\":\"IMAGE\",\"link_description\":\"Enhance well-being with SYMBYX Neuro, a red light therapy helmet targeting the upper neck and back of the head. Clinically proven for holistic benefits.\",\"link_url\":\"https://symbyxbiome.com/products/symbyx-neuro\",\"images\":[{\"image_crops\":[],\"original_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/658224859_2012978025918815_5381607595620742573_n.jpg?_nc_cat=100&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=NmzQaxaQ_PsQ7kNvwHgEa1k&_nc_oc=Adp-9BQTMvF0OkUkW0DJH6TJe5ZBl-Iyv5bCAPC_BH-o2Dlx6Hdy-XBX_qjwWq1pmrHJX12Xl3QT6hA2SlUQwofH&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=ruwhb5-fBE7aW_1pM4I7Tg&_nc_ss=7b2a8&oh=00_Af7ifDxoh8YZrnC2wH8zbeV4ysV7597WSccNqpNBw3ro4Q&oe=6A066898\",\"resized_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/656725899_1969769671090071_2135157542955684891_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=100&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=qU05imqV5MEQ7kNvwEwk3z1&_nc_oc=Adous0z_tS_sBMaxGT0M1f_EY154PaNYKwatonrlhosnwoBoNZwV7Seyug9lMLtnX63dEmY30YGtKbEOJQCxicZs&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=ruwhb5-fBE7aW_1pM4I7Tg&_nc_ss=7b2a8&oh=00_Af6mybsguxbREhsIVhthhuto-mk6mzMJ1kKQB5341sij7g&oe=6A066F06\",\"watermarked_resized_image_url\":\"\"}],\"page_categories\":[\"Medical Service\"],\"page_like_count\":9923,\"title\":\"Experience your Daily Boost from the SYMBYX Neuro\",\"videos\":[],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country