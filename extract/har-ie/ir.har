ked_video_sd_url\":null}],\"is_reshared\":false,\"extra_links\":[],\"extra_texts\":[],\"extra_images\":[],\"extra_videos\":[],\"country_iso_code\":null,\"brazil_tax_id\":null,\"additional_info\":null,\"ec_certificates\":[]},\"is_active\":true,\"has_user_reported\":false,\"report_count\":null,\"menu_items\":[],\"state_media_run_label\":null,\"page_is_deleted\":false,\"page_name\":\"LumiRed\",\"impressions_with_index\":{\"impressions_text\":null,\"impressions_index\":-1},\"gated_type\":\"ELIGIBLE\",\"categories\":[\"UNKNOWN\"],\"is_aaa_eligible\":true,\"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778396400,\"publisher_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"AUDIENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1776495600,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"1626137498604523\",\"collation_count\":1,\"collation_id\":\"1860303118274477\",\"page_id\":\"100199106121016\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"100199106121016\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/100083668906509/\",\"root_reshared_post\":null,\"byline\":null,\"disclaimer_label\":null,\"page_name\":\"Laugh and Share\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/681241521_2004333946838540_4978748429029213255_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=102&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=y4nd5C95ynEQ7kNvwETvx73&_nc_oc=AdosylV60kRbQ8oVUdmgCLfbOQJKGkHxmXUZE_-WYQMGm3MbkBjroUUqpChdfHGxU-4AQrpun45cN-g8KkXmHdJ-&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=3RYrHKp-JWVepgQ1WrR1fQ&_nc_ss=7b2a8&oh=00_Af7o6XQzln16Si7K78CfSV6yDzo9z9IlB-ykxZLYepcBsA&oe=6A066045\",\"event\":null,\"caption\":\"secure.glowfreedoms.com\",\"cta_text\":\"Shop now\",\"cards\":[],\"body\":{\"text\":\"\\ud83d\\udd2c Your Morning Hand Stiffness Is Not An Arthritis Symptom. It Is A Circulation Symptom. \\ud83d\\udd2c\\n58 million Americans have been told the same thing: morning stiffness is a symptom of arthritis. It's expected. It's manageable. \\ud83d\\udcab\\nWhat almost none of them have been told: morning hand stiffness is not primarily a joint symptom. It's a circulation symptom. The joint isn't more damaged overnight \\u2014 it's more poorly supplied with blood. \\u2728\\nCompression gloves address fluid pressure around the joint. Far infrared addresses blood flow into it. Those are two completely different problems \\u2014 and for 70 years, the entire industry has only been treating one. \\ud83e\\ude7a\\nInfraFlex\\u2122 combines both mechanisms in one glove. Immediate compression relief. Continuous FIR circulation improvement. The effect continues after you take it off. \\ud83d\\udc9b\\n$39. 90-day guarantee. Treat the right problem \\ud83d\\udc49 https://secure.glowfreedoms.com/infraflex/139/adv/v2\"},\"cta_type\":\"SHOP_NOW\",\"display_format\":\"VIDEO\",\"link_description\":\"Morning hand stiffness is not primarily a joint symptom \\u2014 it's a circulation symptom. The joint isn't more damaged overnight. It's more poorly supplied with blood. That distinction changes everything about how you treat it\",\"link_url\":\"https://secure.glowfreedoms.com/infraflex/139/adv/v2\",\"images\":[],\"page_categories\":[\"Topic\"],\"page_like_count\":981,\"title\":\"Your Morning Hand Stiffness Is Not An Arthritis Symptom. It Is A Circulation Symptom.\",\"videos\":[{\"video_hd_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/o1/v/t2/f2/m366/AQP5EHQR5cRoBoQBx7N-DRwBevWcOyVBQ0BnjI1CXEWbqkuHI0bSl3BgfDI9lZVwSv9Bhj9H9bR3xDvdtgL9gKdmFKXa_qKwjQY36QPYuKQPmg.mp4?_nc_cat=105&_nc_oc=Ad