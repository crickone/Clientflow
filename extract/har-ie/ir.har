:true,\"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778223600,\"publisher_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"AUDIENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1777532400,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"1696312198028667\",\"collation_count\":1,\"collation_id\":\"727747610359369\",\"page_id\":\"343534518849003\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"343534518849003\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/61562061955567/\",\"root_reshared_post\":null,\"byline\":\"\",\"disclaimer_label\":null,\"page_name\":\"Irries\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/674196641_1680975880016003_395582099157345134_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=105&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=cUOvHnyqR3EQ7kNvwGg_WvW&_nc_oc=Ado8sIwDo9IK_nzm9oPnmPd2IkBIJL36A8cO_wGKi-BVpSEmRJJXcG7mvOjV8WntwCaF1ROVqYTbCkOvsfX9jzLN&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=lBWwDr1hkgN6Af23qVEQvA&_nc_ss=7b2a8&oh=00_Af5Yit3yZKH2oO3h62MfQU6qLbruxiYEyzxL9UvgpFA5xg&oe=6A0661B8\",\"event\":null,\"caption\":\"irries.com\",\"cta_text\":\"Shop now\",\"cards\":[],\"body\":{\"text\":\"\\ud83d\\udea8 Sciatica? Think twice before going under the knife\\u2026 \\u274c\\n\\nEnd sciatic pain with the groundbreaking new Uni Fusion Technology.\\n\\nYour disc is the foundation of your movement \\u2014 but when pain keeps coming back, it can feel like your body is broken beyond repair\\u2026\\n\\nIgnore it too long, and the damage only gets worse.\\nBut before you book that surgery \\u2014 there's something your surgeon probably hasn't told you.\\n\\nYour herniated disc can heal itself, naturally.\\n\\nStudies show a process called \\\"spontaneous disc resorption\\\" allows your disc to retract away from the nerve on its own.\\n\\nThe reason it hasn't happened yet? Your disc hasn't had the right environment to activate it.\\n\\nIntroducing the Irries \\\"Uni Fusion\\\" Belt \\u2014 the first device that activates your disc's natural healing ability in just 20 minutes a day.\\n\\nThis breakthrough device combines four clinically backed therapies to target your sciatica at the source:\\n\\n\\ud83d\\udc49 Mechanical Decompression\\n\\ud83d\\udc49 Soothing Heat Therapy\\n\\ud83d\\udc49 BiWave Light Therapy (Near-Infrared + Red Light)\\n\\ud83d\\udc49 Deep Tissue Massage\\n\\nJust 20 minutes a day from the comfort of your home can make a huge difference.\\n\\nUsers report significant relief in as little as 2\\u20133 weeks of daily use\\u2026\\n\\nReady to get your life back?\\n\\nTry the Irries \\\"Uni Fusion\\\" Belt completely risk-free today:\\n\\n\\u2705 Addresses the real reason everything failed\\n\\u2705 Saves you from surgery\\n\\u2705 4 therapies in 1 device\\n\\u2705 Use it from home in 20 min a day\\n\\u2705 Backed by Dr. Blane Schilling\\n\\u2705 60-Results or Money Back Guarantee\\n\\u2705 FREE Shipping\\n\\nDon't let sciatica push you into a procedure you may not need.\\n\\nTake the first step toward pain-free living now.\\n\\nLearn more: irries.com/iufb\"},\"cta_type\":\"SHOP_NOW\",\"display_format\":\"VIDEO\",\"link_description\":null,\"link_url\":\"https://irries.com/products/irries-uni-fusion-belt?view=irries-uni-fusion-belt-sp\",\"images\":[],\"page_categories\":[\"Health & wellness website\"],\"page_like_count\":2061,\"title\":\"Try this before falling into sciatica surgery...\",\"videos\":[{\"video_hd_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/o1/v/t2/f2/m366/AQPuHDOeZP1KFg2C8gJTvUMTrLaUd8wtdQZF9le3c8tQz