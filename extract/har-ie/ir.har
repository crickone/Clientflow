            "text": "av=100003752534281&__aaid=0&__user=100003752534281&__a=1&__req=w&__hs=20583.HYP%3Acomet_plat_default_pkg.2.1...0&dpr=1&__ccg=EXCELLENT&__rev=1039190484&__s=2o8s94%3Ax5mm25%3Aywmrxz&__hsi=7638279735426205550&__dyn=7xeUmwlECdwn8K2Wmh0no6u5U4e1Fx-ewSAwHwNw9G2S2q0_EtxG4o0B-qbwgE1EEb87C1xwEwgo9oO0n24oaEd86a3a1YwBgao6C0Mo6i588Etw8WfK1LwPxe2GewbCXwJwmE2eUlwhE2Lw6OyES0gq0K-1LwqobU3Cwr86C1nwf6Eb87u0jW1ww3dUdo&__csr=hs6zcBqd6W2yq8AAiiL9GmhqtFbhulqKyfSqudACmh6zVOeUCez4WzF8jz4fh8hLgy1au7EC1Kxe-58WeAwpV8fE6u0zGwRwjo6G361cw8a362q2C0xo6211wtUeE18o045S0pS04QU5y016Aw16206H808de00w-E08g801oX80cdo0tjV80pNw9K0hq&__hsdp=l12JRmCC2J48A4WGmuaAEGyGGFydjP99i4h4Fk8zoSJem7kbyrg5j8l0x6ETjhoWuewlEJ05Xo1082IwzzEcElz8bEbocK6eiz8NU09p80nOw63w0kJ802ggw0e2K&__hblp=012i0b_Dw1960dKwgE1880S2045okw2580JS02aa05981V81do0tZwBw9i0a0w2LE3yw0EEw8K02sC03bS02xS04lomw2w81f80aCE0Hu04-U0rlw&__sjsp=l12JRmCC2J48A4WGmuaAEGyGGFydjP99i4h4Fk8zoSJem7kbyrg5j8l0x6H8QQmeDzE5qbg1uS0g20H88UW3a5oO2W2S3bxzAEOc03R-&__comet_req=94&fb_dtsg=NAfsOxll6hOA4hmvCUSVJLgSDZOOF2PSaWyN179z02nJyqfd7OSdtuQ%3A50%3A1778324001&jazoest=25461&lsd=Ko13uURaXGqJjrMTaGs3a-&__spin_r=1039190484&__spin_b=trunk&__spin_t=1778425587&fb_api_caller_class=RelayModern&fb_api_req_friendly_name=AdLibrarySearchPaginationQuery&server_timestamps=true&variables=%7B%22activeStatus%22%3A%22ACTIVE%22%2C%22adType%22%3A%22ALL%22%2C%22bylines%22%3A%5B%5D%2C%22collationToken%22%3A%2255f5ba63-61bc-4f42-8eed-e4d667db4921%22%2C%22contentLanguages%22%3A%5B%5D%2C%22countries%22%3A%5B%22IE%22%5D%2C%22cursor%22%3A%22AQHSMv9P6xyg_1ZY_zZdCKStg0ThKTctkwYA6-39O4JFEkrzQuq4TswcYSfRdG0Lccvt%22%2C%22excludedIDs%22%3A%5B%5D%2C%22first%22%3A30%2C%22isTargetedCountry%22%3Afalse%2C%22location%22%3Anull%2C%22mediaType%22%3A%22ALL%22%2C%22multiCountryFilterMode%22%3Anull%2C%22pageIDs%22%3A%5B%5D%2C%22potentialReachInput%22%3A%5B%5D%2C%22publisherPlatforms%22%3A%5B%5D%2C%22queryString%22%3A%22infrared%20therapy%22%2C%22regions%22%3A%5B%5D%2C%22searchType%22%3A%22KEYWORD_UNORD