ublisher_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"AUDIENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1776668400,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"2069315790552225\",\"collation_count\":1,\"collation_id\":\"743891398737241\",\"page_id\":\"102348431747573\",\"snapshot\":{\"branded_content\":{\"page_id\":\"640294035835543\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/61576020390061/\",\"page_name\":\"HeatPod Sauna Blanket by Hydragun\"},\"page_id\":\"102348431747573\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/thehydragun/\",\"root_reshared_post\":null,\"byline\":null,\"disclaimer_label\":null,\"page_name\":\"Hydragun\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/594559449_3768177776823322_3401467770631798611_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=104&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=RPPhUKPC83kQ7kNvwFN8Rz4&_nc_oc=AdqliCUcYZoBzzene2NLB0A3_CflWaIFFvvUIzUchYaNDwH-esDVJvXKfTlDbkZ_-eTbWruED7uK3u_qQQ_agDdx&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=rkW1PeX5vPLZI9uVDNqd6Q&_nc_ss=7b2a8&oh=00_Af6-oSVsE5qLu63XS6QBhOaKsLwfugZTsBtPSitYcKZDfw&oe=6A065845\",\"event\":null,\"caption\":\"hydragun.com/heat-therapy\",\"cta_text\":\"Learn more\",\"cards\":[],\"body\":{\"text\":\"What a sauna session does after your workout:\\n\\ud83d\\udd25 Boosts circulation & speeds nutrient delivery\\n\\ud83d\\udc86\\u200d\\u2642\\ufe0f Relaxes tight muscles and reduces stress\\n\\ud83c\\udf21\\ufe0f Helps with recovery if you give your body a brief cooldown first\\n\\nBut go in too soon after training?\\n\\u26a0\\ufe0f Excess heat can spike inflammation\\n\\u23f3 Short rest window still matters for hypertrophy\\n\\nInfrared sauna cabins are great, but:\\n\\ud83c\\udfe0 You need space + time\\n\\ud83d\\udcb8 Sessions get pricey fast\\n\\ud83d\\udeab Heat is often slower to build and harder to keep consistent\\n\\nIf you want a stronger, more convenient heat therapy option, the HeatPod Sauna Blanket delivers far-infrared heat that:\\n\\ud83d\\udd25 Hits deeper into muscle tissue\\n\\ud83d\\udca8 Heats up faster\\n\\ud83d\\udcba Works anywhere at home\\n\\ud83d\\udcaf Provides full-body recovery without the cabin setup\\n\\nLearn more about the HeatPod Sauna Blanket:\\nhttps://www.hydragun.com/pages/heat-therapy\\n\\n#heatpod #hydragun #sauna #infraredsauna #saunablanket\"},\"cta_type\":\"LEARN_MORE\",\"display_format\":\"VIDEO\",\"link_description\":null,\"link_url\":\"https://www.hydragun.com/pages/heat-therapy?utm_source=\\u00257B\\u00257Bsite_source_name\\u00257D\\u00257D&utm_medium=\\u00257B\\u00257Bplacement\\u00257D\\u00257D\",\"images\":[],\"page_categories\":[\"Shopping\"],\"page_like_count\":18311,\"title\":\"Should you sauna after a workout?\",\"videos\":[{\"video_hd_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/o1/v/t2/f2/m366/AQOxA-IhotoVkU0jO_gFnnI66kU9qb1f2ppIndkghX1IF4zIs--ZIbIlMYRfGG_OFOAMbOgkJM7wcpgL08m95eJB9raRrPPIEiuirY9_t5_oIA.mp4?_nc_cat=106&_nc_oc=AdqsiYenhfc2rD34XqjBJB60vlAsxj3XXPrQVTN_SiR7JiJNdWkLVccKyE0hcWK7ujTApgMfq7VC6q1y4HxgqSCI&_nc_sid=5e9851&_nc_ht=scontent.fdub4-2.fna.fbcdn.net&_nc_ohc=yflfswNgccIQ7kNvwEPhazV&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5WSV9VU0VDQVNFX1BST0RVQ1RfVFlQRS4uQzMuNzEyLmRhc2hfaDI2NC1iYXNpYy1nZW4yXzcyMHAiLCJ4cHZfYXNzZXRfaWQiOjMxMDY0MTIxNzI4ODg1MzcsImFzc2V0X2FnZV9kYXlzIjoxNTUsInZpX3VzZWNhc2VfaWQiOjEwNzk5LCJkdXJhdGlvbl9zIjoyMCwidXJsZ2VuX3NvdXJjZSI6Ind3dyJ9&ccb=17-1&vs=f3026d29723ce283&_nc_vs=HBksFQIYRWZiX2VwaGVtZXJhbC81OTQwNTgwNjA3QUNGMzgxNkFGQjJCREY1NzJGQTI5Rl9tdF8xX3ZpZGVvX2Rhc2hpbml0Lm1wNBUAAsgBEgAVAhhAZmJ