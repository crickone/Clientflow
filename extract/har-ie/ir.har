lse,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778396400,\"publisher_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"MESSENGER\"],\"start_date\":1777359600,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"908978088167578\",\"collation_count\":1,\"collation_id\":\"1329380252564097\",\"page_id\":\"101525186035378\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"101525186035378\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/100085214598609/\",\"root_reshared_post\":null,\"byline\":\"\",\"disclaimer_label\":null,\"page_name\":\"renpho\",\"page_profile_picture_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/623433704_2017196728840573_2723564780451428760_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=108&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=JH3Ro2rmMAkQ7kNvwGG81uP&_nc_oc=AdrKUIjWECeLolRQivqU9Se9g-Vh19djzzC5ng0gKqblUuLD9BITKpgBzuQ2VOSbtFmnhTWYsqkQPAcxSkJYLJSG&_nc_zt=14&_nc_ht=scontent.fdub8-1.fna&_nc_gid=e2xYN4Z63Px3FgV3TfQPIQ&_nc_ss=7b2a8&oh=00_Af41amobr5XjfVsWd3TBcxsctzCZpqxVBL1TmF7DQqis_w&oe=6A067449\",\"event\":null,\"caption\":\"renpho.eu\",\"cta_text\":\"Order now\",\"cards\":[],\"body\":{\"text\":\"\\u2728 FDA-cleared. Clinically proven. Results-driven. \\n\\nThis isn\\u2019t just another LED mask. With 324 medical-grade LEDs (2X more than the industry standard), Artemis delivers precise wavelengths of red (630nm+850nm), blue (415nm+850nm), and near-infrared (415nm+630nm+850nm) light deep into your skin layers \\u2014 the same professional-grade technology trusted in dermatology clinics.\\n\\n\\ud83d\\udd2c What it does for your skin:\\n\\nRed + NIR: Stimulates collagen production, improves skin density, reduces fine lines & sagging.\\nBlue + NIR: Neutralizes acne-causing bacteria, purifies skin, soothes inflammation.\\nTriple Wavelength Mode: Works across multiple skin layers, rejuvenating and balancing for healthier, radiant skin.\\n\\n\\ud83d\\udca1 Clinically proven results:\\n\\n85\\u0025 of users reported visible skin improvement\\u00b9\\n2X LED density means deeper, faster results\\nSafe, non-invasive, and easy to use from home\\n\\nIn just 10 minutes a day, Artemis becomes your personal skin therapist \\u2014 smoothing, clarifying, and revitalizing your complexion.\\n\\ud83c\\udf1f Glow smarter. Age gracefully. Experience confidence like never before.\\n\\n\\ud83d\\udc49 Ready to see results? Shop Artemis today: \\nhttps://renpho.eu/products/artemis-led-light-soft-mask\"},\"cta_type\":\"ORDER_NOW\",\"display_format\":\"IMAGE\",\"link_description\":\"LED Light Soft Mask\",\"link_url\":\"https://renpho.eu/products/artemis-led-light-soft-mask\",\"images\":[{\"image_crops\":[],\"original_image_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/622989220_1556203832334762_1192820082270158861_n.jpg?_nc_cat=107&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=5y1UvDsdX-8Q7kNvwFEHnEz&_nc_oc=AdpmOhGRXXXpsawEpUUSECR6wWx_fSGjNGA3ae-CrVKKbqLywj18-UeacJ2JxFCFTI_erYJ7sR9EMd3ycNW5PZu2&_nc_zt=14&_nc_ht=scontent.fdub8-1.fna&_nc_gid=e2xYN4Z63Px3FgV3TfQPIQ&_nc_ss=7b2a8&oh=00_Af4CbGnZObTbrkzU8OXXwqX9gbskFKx4r3rgiJF6ej005w&oe=6A0684F4\",\"resized_image_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/624377877_1258005892871499_1865576377545719439_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=107&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=fUbTXjEWDRQQ7kNvwHboFTi&_nc_oc=Adpjzhl7sig1oeYVNBncKAHCjnvhiGSnh1djpGIsKzyOVEdlMrtg3l7kuTBxd-Zb7Auof1qsvQNKhsNi85dIy5fw&_nc_zt=14&_nc_ht=scontent.fdub8-1.fna&_nc_gid=e2xYN4Z63Px3FgV3TfQPIQ&_nc_ss=7b2a8&oh=00_Af7hsHARJ5dTv1OiKQT1R1Dhfg188mxVck2w_q55dlkCvg&oe=6A068B11\",\"watermarked_resized_image