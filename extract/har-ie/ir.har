"contains_digital_created_media\":false,\"reach_estimate\":null,\"currency\":\"\",\"spend\":null,\"end_date\":1778396400,\"publisher_platform\":[\"FACEBOOK\",\"INSTAGRAM\",\"AUDIENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1777446000,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"2137317430376173\",\"collation_count\":1,\"collation_id\":\"2686295041753016\",\"page_id\":\"102348431747573\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"102348431747573\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/thehydragun/\",\"root_reshared_post\":null,\"byline\":null,\"disclaimer_label\":null,\"page_name\":\"Hydragun\",\"page_profile_picture_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/665821971_1244530544512448_2876501693904867205_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=107&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=lKP_eR4qMpMQ7kNvwF3cO3R&_nc_oc=AdrMx78qSWELLYMMeLIIjLJ_6FxYAFrHknXRgZRu-5LcjsCCCS1NUgzWyCXv20lezaeVmfwYmrbNgxgOn2oCK1gC&_nc_zt=14&_nc_ht=scontent.fdub8-1.fna&_nc_gid=lBWwDr1hkgN6Af23qVEQvA&_nc_ss=7b2a8&oh=00_Af5vVSjvTLjK99wi06BoN8RoNEfloSlowTG_6fBqCNM85A&oe=6A0664B5\",\"event\":null,\"caption\":\"hydragun.com/heat-therapy\",\"cta_text\":\"Learn more\",\"cards\":[],\"body\":{\"text\":\"Prometheus went to great lengths to bring fire to humanity, but he probably didn\\u2019t envision it being this portable \\u2014 or this comfortable. We\\u2019ve taken that ancient elemental power and refined it into the ultimate recovery tool for the modern human.\\n\\nThe HeatPod Sauna Blanket delivers professional-grade infrared therapy in the comfort of your own home.\\n\\n\\ud835\\uddd5\\ud835\\uddf2\\ud835\\uddfb\\ud835\\uddf2\\ud835\\uddf3\\ud835\\uddf6\\ud835\\ude01\\ud835\\ude00 \\ud835\\uddfc\\ud835\\uddf3 \\ud835\\udddb\\ud835\\uddf2\\ud835\\uddee\\ud835\\ude01 \\ud835\\udde7\\ud835\\uddf5\\ud835\\uddf2\\ud835\\uddff\\ud835\\uddee\\ud835\\uddfd\\ud835\\ude06\\n\\ud83d\\udd25 Deep Detoxification: Infrared heat penetrates deep into your tissue to flush out toxins and heavy metals.\\n\\u2764\\ufe0f Cardiovascular Boost: Mimics the effects of a light workout, improving circulation and heart health.\\n\\ud83d\\udca4 Superior Sleep: Calms the nervous system and lowers cortisol, prepping your body for deep rest.\\n\\ud83e\\uddd8 Muscle Recovery: Targets inflammation and accelerates tissue repair after a long day.\\n\\n\\ud835\\uddea\\ud835\\uddf5\\ud835\\uddee\\ud835\\ude01 \\ud835\\udde0\\ud835\\uddee\\ud835\\uddf8\\ud835\\uddf2\\ud835\\ude00 \\ud835\\udddb\\ud835\\uddf2\\ud835\\uddee\\ud835\\ude01\\ud835\\udde3\\ud835\\uddfc\\ud835\\uddf1 \\ud835\\udde6\\ud835\\uddee\\ud835\\ude02\\ud835\\uddfb\\ud835\\uddee \\ud835\\uddd5\\ud835\\uddf9\\ud835\\uddee\\ud835\\uddfb\\ud835\\uddf8\\ud835\\uddf2\\ud835\\ude01 \\ud835\\udde6\\ud835\\uddfc \\ud835\\uddda\\ud835\\uddff\\ud835\\uddf2\\ud835\\uddee\\ud835\\ude01\\n\\u26a1 Instant Warmth: Reaches 185\\u00b0F/85\\u00b0C in minutes, providing immediate relief on demand.\\n\\ud83e\\uddfc Hygienic Design: Crafted with premium, sweat-resistant vegan leather that wipes clean in seconds.\\n\\ud83d\\udee1\\ufe0f Zero-EMF Shielding: Advanced shielding ensures you get all the benefits with none of the radiation.\\n\\ud83d\\udce6 Compact Living: Designed to fold away and slide under your bed or into a closet effortlessly.\\n\\n\\ud835\\udde6\\ud835\\uddf5\\ud835\\uddfc\\ud835\\uddfd \\ud835\\ude01\\ud835\\uddf5\\ud835\\uddf2 \\ud835\\udddb\\ud835\\uddf2\\ud835\\uddee\\ud835\\ude01\\ud835\\udde3\\ud835\\uddfc\\ud835\\uddf1 \\ud835\\ude01\\ud835\\uddfc\\ud835\\uddf1\\ud835\\uddee\\ud835\\ude06.\\nhttps://www.hydragun.com/pages/heat-therapy\"},\"cta_type\":\"LEARN_MORE\",\"display_format\":\"VIDEO\",\"link_description\":null,\"link_url\":\"https://www.hydragun.com/pages/heat-therapy\",\"images\":[],\"page_categories\":[\"Shopping\"],\"page_like_count\":18311,\"title\":\"The Gift of Fire, Reimagined.\",\"videos\":[{\"video_hd_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/o1/v/t2/f2/m366/AQOXhYC8m5reCVs41EYZtFL8OzW3HZcAmWBvoE00TwD09kJTAlBeFrU0q6khrPOyZBz21eSuWZdjS7dfcQHmKidzFdR8D02ZnIfqk7oiJuBZLg.mp4?_nc_cat=111&_nc_oc=AdrzE0gbgr9bgVNMZv44zLIgnqO4RfP5EKwCCkCjfvgvhCdj4CCxJegzH-Jkhtz9dhP2bbqCYF2g0z_ygE3a-_kN&_nc_sid=5e9851&_nc_ht=scontent.fdub8-1.fna.fbcdn.net&_nc_ohc=NKGMNV1VxisQ7kNvwEF8u7O&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5WSV9VU0VDQVNFX1BST0RVQ1RfVFlQRS4uQzMuNzIwLmRhc2hfaDI2NC1iYXNpYy1nZW4yXzcyMHAiLCJ4cHZfYXNzZXRfaWQiOjE0NzcwMTIyMjA0OTIxMTAsImFzc2V0X2FnZV9kYXlzIjozMywidmlfdXNlY2FzZV9pZCI6MTA3OTksImR1cmF0aW9uX3MiOjM0LCJ1cmxnZW5fc291cmNlIjoid3d3In0\\u00253D&ccb=17-1&vs=e19de4c98e297adc&_nc_vs=HBksFQIYRWZiX2VwaGVtZXJhbC83RTRCMzRDNTAzMUZFQ0VFNUM1MzJDMkI1MUREMTc4MV9tdF8xX3ZpZGVvX2Rhc2hpbml0Lm1wNBUAAsgBEgAVAhhAZmJfcGVybWFuZW50L0MyNDJFM0NCNkNCMDA5ODRERDQ4OTc3RDk2M0NBNzg3X2F1ZGlvX2Rhc2hpbml0Lm1wNBUCAsgBEgAoABgAGwKIB3VzZV9vaWwBMRJwcm9ncmVzc2l2ZV9yZWNpcGUBMRUAACac5dnLttWfBRUCKAJDMywXQEF_Gp--dskYGWRhc2hfaDI2NC1iYXNpYy1nZW4yXzcyMHARAHUAZd6oAQA&_nc_gid=lBWwDr1hkgN6Af23qVEQvA&_nc_ss=7b2a8&_nc_zt=28&oh=00_Af7ZHjtlLVClx_vR7VwYy2IPgFlhkTb2jguJxz7kFDM-xw&oe=6A066CCD\",\"video_preview_image_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/663407737_1473918317734018_4809702305349521785_n.jpg?_nc_cat=100&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=EDHkxww_yywQ7kNvwGoc4C5&_nc_oc=Adqwob9sL-jhvBPO6eikNaw8gzcTFyhxsGRhrx8yJPI2dudifvbVeuXFufW5_GM0O-Jz2E8wbFfO-T4fLuYzoxUy&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=lBWwDr1hkgN6Af23qVEQvA&_nc_ss=7b2a8&oh=00_Af6aapgQJF6G91UjrlN_oeqqEWjiFnq7f-aHdftI5LxT1A&oe=6A066DA1\",\"video_sd_url\":\"https://scontent.fdub4-2.fna.f