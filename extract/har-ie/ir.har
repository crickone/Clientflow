            "size": 167896,
            "mimeType": "text/html",
            "text": "{\"data\":{\"ad_library_main\":{\"search_results_connection\":{\"edges\":[{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"826174507204768\",\"collation_count\":1,\"collation_id\":\"1656907382010575\",\"page_id\":\"360373860492555\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"360373860492555\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/healray.official/\",\"root_reshared_post\":null,\"byline\":null,\"disclaimer_label\":null,\"page_name\":\"HealRay\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/666251523_917457187955312_624211329559686274_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=106&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=IrJEYw9gulUQ7kNvwGWTmik&_nc_oc=AdpB_jDgINDOtxgYEu1yQD8ssM3c77yi27v5py8CVc5uWsYhZ0AUxUdlTYdeLPQQR00zTxt3EoNu0h21-EzUPG8m&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=DYn9GJzeujERi96M2I5Tlw&_nc_ss=7b2a8&oh=00_Af72rDR49XlJ71zg9UcENX1NVPE66yk0oVCq_YMk02ZuDA&oe=6A066367\",\"event\":null,\"caption\":\"www.myhealray.com\",\"cta_text\":\"Learn more\",\"cards\":[],\"body\":{\"text\":\"Receding gums aren\\u2019t just about brushing harder or flossing more.\\n\\nThey\\u2019re often linked to collagen breakdown and chronic inflammation.\\n\\nHealRay uses targeted red and infrared light to support gum tissue at the source - right from home.\\n\\n\\u2705 Supports healthier gum structure\\n\\u2705 Helps calm irritation and sensitivity\\n\\u2705 Takes just 5 minutes a day\\n\\nLearn what\\u2019s really happening inside receding gums \\u2192 https://www.myhealray.com/dental-news-advertorial\"},\"cta_type\":\"LEARN_MORE\",\"display_format\":\"VIDEO\",\"link_description\":null,\"link_url\":\"https://www.myhealray.com/dental-news-advertorial\",\"images\":[],\"page_categories\":[\"Cosmetic Dentist\"],\"page_like_count\":2610,\"title\":\"Try It Risk Free For 60 Days\",\"videos\":[{\"video_hd_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/o1/v/t2/f2/m366/AQPmcz1TKU_v0o8vbDxpUTeT6O