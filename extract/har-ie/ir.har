INSTAGRAM\",\"AUDIENCE_NETWORK\",\"MESSENGER\",\"THREADS\"],\"start_date\":1777532400,\"contains_sensitive_content\":false,\"total_active_time\":null,\"regional_regulation_data\":{\"finserv\":{\"is_deemed_finserv\":false,\"is_limited_delivery\":false},\"tw_anti_scam\":{\"is_limited_delivery\":false}},\"hide_data_status\":\"NONE\",\"fev_info\":null,\"ad_id\":null,\"targeted_or_reached_countries\":[]}],\"__typename\":\"CollatedSearchResults\"},\"cursor\":null},{\"node\":{\"collated_results\":[{\"ad_archive_id\":\"1664839074552881\",\"collation_count\":1,\"collation_id\":\"1335541278441953\",\"page_id\":\"100199106121016\",\"snapshot\":{\"branded_content\":null,\"page_id\":\"100199106121016\",\"page_is_deleted\":false,\"page_profile_uri\":\"https://www.facebook.com/100083668906509/\",\"root_reshared_post\":null,\"byline\":null,\"disclaimer_label\":null,\"page_name\":\"Laugh and Share\",\"page_profile_picture_url\":\"https://scontent.fdub4-2.fna.fbcdn.net/v/t39.35426-6/684152773_1469604587990742_3869355864430791383_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=107&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=3NGhQZL3-m0Q7kNvwEr85iH&_nc_oc=AdpiWTAfGpVDp88jqOXritA0VCpqK4AeG2npCs8BArjTjaU6BkcVYxcjw6nMKS_lPlNjkCywtBQ-lXzY5XA2-tjf&_nc_zt=14&_nc_ht=scontent.fdub4-2.fna&_nc_gid=QKF5zzy3gfPmnT8ce9pHFw&_nc_ss=7b2a8&oh=00_Af4_tnOzUg0_lXtj_e00BuGpGZ6C7UKHe0JL-xv3KRnKww&oe=6A066CA5\",\"event\":null,\"caption\":\"secure.glowfreedoms.com\",\"cta_text\":\"Shop now\",\"cards\":[],\"body\":{\"text\":\"\\ud83d\\udd2c Your Morning Hand Stiffness Is Not An Arthritis Symptom. It Is A Circulation Symptom. \\ud83d\\udd2c\\n58 million Americans have been told the same thing: morning stiffness is a symptom of arthritis. It's expected. It's manageable. \\ud83d\\udcab\\nWhat almost none of them have been told: morning hand stiffness is not primarily a joint symptom. It's a circulation symptom. The joint isn't more damaged overnight \\u2014 it's more poorly supplied with blood. \\u2728\\nCompression gloves address fluid pressure around the joint. Far infrared addresses blood flow into it. Those are two completely different problems \\u2014 and for 70 years, the entire industry has only been treating one. \\ud83e\\ude7a\\nInfraFlex\\u2122 combines both mechanisms in one glove. Immediate compression relief. Continuous FIR circulation improvement. The effect continues after you take it off. \\ud83d\\udc9b\\n$39. 90-day guarantee. Treat the right problem \\ud83d\\udc49 https://secure.glowfreedoms.com/infraflex/139/adv/v2\"},\"cta_type\":\"SHOP_NOW\",\"display_format\":\"VIDEO\",\"link_description\":\"Morning hand stiffness is not primarily a joint symptom \\u2014 it's a circulation symptom. The joint isn't more damaged overnight. It's more poorly supplied with blood. That distinction changes everything about how you treat it\",\"link_url\":\"https://secure.glowfreedoms.com/infraflex/139/adv/v2\",\"images\":[],\"page_categories\":[\"Topic\"],\"page_like_count\":981,\"title\":\"Your Morning Hand Stiffness Is Not An Arthritis Symptom. It Is A Circulation Symptom.\",\"videos\":[{\"video_hd_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/o1/v/t2/f2/m366/AQPRgjcRxd-XplITSrfROYx1kqr-kfoHeB8uJQpDqxbtZEXCajRUeSbhQKGy0b2Xrmf51LIHKvdSklHRjj1AEQSXHfBX26Wr1p4BC6nt5G9HbA.mp4?_nc_cat=111&_nc_oc=AdrXLLYeWmddI7MtBj14pqR39GQys2wMcXwsy3BAiJDArZTGuPFqbX49lbahuF7YBNR83_6I8WfeNV_CplzAwS_-&_nc_sid=5e9851&_nc_ht=scontent.fdub8-1.fna.fbcdn.net&_nc_ohc=ETtTjRLqARAQ7kNvwHjMwfj&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5WSV9VU0VDQVNFX1BST0RVQ1RfVFlQRS4uQzMuNzIwLmRhc2hfaDI2NC1iYXNpYy1nZW4yXzcyMHAiLCJ4cHZfYXNzZXRfaWQiOjI3MTgwMTA4Njg1NzY0ODAsImFzc2V0X2FnZV9kYXlzIjoxMywidmlfdXNlY2FzZV9pZCI6MTAxMzksImR1cmF0aW9uX3MiOjEzMCwidXJsZ2VuX3NvdXJjZSI6Ind3dyJ9&ccb=17-1&vs=d52d5148727c27ce&_nc_&_nc_gid=QKF5zzy3gfPmnT8ce9pHFw&_nc_ss=7b2a8&_nc_zt=28&oh=00_Af50HDZi_HhjLTOP9x_qnEDve19czPUh-gfc2hEfFnJXbw&oe=6A066035\",\"video_preview_image_url\":\"https://scontent.fdub8-1.fna.fbcdn.net/v/t39.35426-6/682483038_1322079679784897_306