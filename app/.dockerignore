# Excludes from the Docker build context (gitignore syntax). Mirrors
# .railwayignore. The builder stage does `COPY . .`, so anything not listed
# here is copied into the build context and can end up baked into an image
# layer — this keeps tenant data (clinic.db/control.db PII), local
# node_modules, VCS history, and secrets out of it.
data/
node_modules/
.next/
.git/
.superpowers/
*.db*
.env
.env.*
*.log
.DS_Store
